rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global deny-all catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Admin is identified by their Google account email
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'fernandomariodasmartins@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // Returns the list of school names assigned to the currently signed-in superintendent.
    // The superintendentes collection is keyed by email address.
    function myEscolas() {
      let email = request.auth.token.email;
      return email != null &&
        exists(/databases/$(database)/documents/superintendentes/$(email))
        ? get(/databases/$(database)/documents/superintendentes/$(email)).data.get('escolas', [])
        : [];
    }

    // True if the admin, OR if the school name is in the user's assigned list
    function canWriteEscola(escolaNome) {
      return isAdmin() || (isSignedIn() && escolaNome in myEscolas());
    }

    // --- Superintendentes ---
    // Admin can list/get/write all. Non-admins can only get their own record.
    match /superintendentes/{emailKey} {
      allow get: if isSignedIn() && (isAdmin() || request.auth.token.email == emailKey);
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // --- Schools ---
    match /schools/{schoolId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidId(schoolId) &&
        incoming().nome is string && incoming().nome.size() <= 150 &&
        incoming().codInep is string && incoming().codInep.size() <= 50 &&
        incoming().cidade is string && incoming().cidade.size() <= 100 &&
        incoming().matriculas is number &&
        incoming().idebMedio is number &&
        incoming().metaIdeb is number &&
        incoming().status is string;
      allow update: if isSignedIn() && isValidId(schoolId) &&
        canWriteEscola(resource.data.nome) &&
        incoming().nome is string && incoming().nome.size() <= 150 &&
        incoming().codInep is string && incoming().codInep.size() <= 50 &&
        incoming().cidade is string && incoming().cidade.size() <= 100 &&
        incoming().matriculas is number &&
        incoming().idebMedio is number &&
        incoming().metaIdeb is number &&
        incoming().status is string;
      allow delete: if isAdmin() && isValidId(schoolId);
    }

    // --- Turmas ---
    match /turmas/{turmaId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(turmaId) &&
        canWriteEscola(incoming().escolaNome) &&
        incoming().escolaId is string && incoming().escolaId.size() <= 128 &&
        incoming().escolaNome is string && incoming().escolaNome.size() <= 150 &&
        incoming().nome is string && incoming().nome.size() <= 100 &&
        incoming().ano is string && incoming().ano.size() <= 20 &&
        incoming().periodo is string && incoming().periodo.size() <= 50 &&
        incoming().alunosSinalizados is number;
      allow delete: if isSignedIn() && isValidId(turmaId) &&
        canWriteEscola(resource.data.escolaNome);
    }

    // --- Grades (no school reference in schema — allow any signed-in user) ---
    match /grades/{gradeId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(gradeId) &&
        incoming().nome is string && incoming().nome.size() <= 150 &&
        incoming().turma is string && incoming().turma.size() <= 100 &&
        incoming().portugues is number &&
        incoming().matematica is number &&
        incoming().ciencias is number &&
        incoming().bimestre is string;
      allow delete: if isSignedIn() && isValidId(gradeId);
    }

    // --- Visitas ---
    match /visitas/{visitaId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(visitaId) &&
        canWriteEscola(incoming().escola) &&
        incoming().escola is string && incoming().escola.size() <= 150 &&
        incoming().tecnico is string && incoming().tecnico.size() <= 150 &&
        incoming().data is string && incoming().data.size() <= 30 &&
        incoming().foco is string && incoming().foco.size() <= 200 &&
        incoming().status is string;
      allow delete: if isSignedIn() && isValidId(visitaId) &&
        canWriteEscola(resource.data.escola);
    }
  }
}
