rules_version = '2';

// ============================================================================
// REGRAS OFICIAIS DE PRODUÇÃO — publicadas na Fase 1F (promovidas a partir
// de firestore.rules.proposed, revisado e aprovado nas Fases 0/1C/1D/1E).
// firestore.rules.proposed foi removido do repositório após a publicação —
// esta é a única fonte de verdade de regras de segurança do projeto.
//
// Problema que estas regras corrigem (versão anterior a Fase 1F): a leitura
// de schools/turmas/grades/visitas exigia apenas isSignedIn() — qualquer
// conta Google autenticada, mesmo nunca cadastrada como superintendente,
// conseguia ler nomes e notas de alunos. As regras de ESCRITA já eram
// corretamente restritas a superintendentes cadastrados (via
// myEscolas()/canWriteEscola()) — só a leitura estava aberta demais.
//
// Mudança de schema (Fase 0 + Fase 1C):
//   - superintendentes/{email} ganha os campos OBRIGATÓRIOS `ativo: boolean`
//     e `role: 'admin' | 'superintendent'` (sem default — create/update
//     exigem os dois explicitamente).
//   - FAIL-CLOSED: um documento SEM `ativo`, ou com `ativo: false`, é tratado
//     como NÃO autorizado. O admin raiz (isPlatformAdmin(), checado só por
//     e-mail, sem depender do documento) continua com acesso mesmo assim,
//     mas qualquer OUTRO superintendente cadastrado sem o campo `ativo`
//     FICARÁ BLOQUEADO até rodar scripts/migrate-ativo-field.mjs.
//   - HIERARQUIA (Fase 1C): admin raiz > admin cadastrado (role: 'admin',
//     não-raiz) > superintendente comum (role: 'superintendent'). Admin
//     cadastrado só cria/edita superintendentes comuns — não pode criar
//     outro admin, promover ninguém, editar outro admin, nem excluir
//     ninguém. Só o admin raiz concede/retira role: 'admin' e exclui
//     usuários; o próprio documento do admin raiz nunca pode ser
//     desativado, rebaixado ou excluído, nem por ele mesmo.
//   `src/components/SuperintendentesView.tsx` e `src/lib/superintendentService.ts`
//   já foram atualizados na Fase 1C para enviar `ativo`/`role` e respeitar
//   essa hierarquia — ver relatório da Fase 1C para o estado exato.
//
// LIMITAÇÃO CONHECIDA (ver auditoria, item "riscos restantes"):
//   A coleção `grades` não tem campo escolaNome/escolaId no schema atual
//   (o campo `turma` é um nome de exibição como "3º Ano A - Matutino", que
//   SE REPETE entre escolas diferentes nos dados de exemplo — não é uma
//   chave confiável para localizar a escola dona da nota via lookup em
//   `turmas`). Por isso não é possível aplicar aqui o princípio de menor
//   privilégio por escola em `grades` sem alterar o formato de dados
//   (fora do escopo pedido) ou mexer em NotasView.tsx (também fora do
//   escopo pedido). Como mitigação parcial, `grades` fica restrito a
//   superintendentes cadastrados e ativos (fecha o buraco de "qualquer
//   conta Google"), mas não é isolado por escola. Ver recomendação no
//   relatório para uma fase futura.
//
// FASE 2A — adição (sem alterar nenhuma regra acima): school_years,
// enrollment_snapshots, imports e audit_logs. Mesmo modelo de autorização já
// usado por schools/turmas (isAuthorized() para leitura, canWriteEscola()
// para escrita por nome de escola), com hasOnly() nos quatro para rejeitar
// campo inesperado — mais estrito que schools/turmas/grades/visitas (que não
// usam hasOnly), porque são coleções novas sem dado legado a acomodar.
// audit_logs é somente-criação: update/delete sempre bloqueados, mesmo para
// admin, para que a trilha de auditoria nunca possa ser alterada depois de
// gravada.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Barreira global: nega tudo que não casar com uma regra específica abaixo.
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return isSignedIn() && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : null;
    }

    // Admin "raiz"/break-glass: identidade explícita, não é checagem de
    // domínio de e-mail (@seduc.ce.gov.br não é usado como autorização).
    function isPlatformAdmin() {
      return isSignedIn() && myEmail() == 'fernandomariodasmartins@gmail.com';
    }

    function superintendentDoc() {
      return get(/databases/$(database)/documents/superintendentes/$(myEmail()));
    }

    function isRegisteredSuperintendent() {
      return isSignedIn() && myEmail() != null &&
        exists(/databases/$(database)/documents/superintendentes/$(myEmail()));
    }

    // FAIL-CLOSED: `ativo` ausente ou false == não autorizado. Só um
    // documento com `ativo == true` explícito passa. Isso exige rodar a
    // migração (scripts/migrate-ativo-field.mjs) antes de publicar estas
    // regras, senão superintendentes existentes ficam bloqueados.
    function isActiveSuperintendent() {
      return isRegisteredSuperintendent() &&
        superintendentDoc().data.get('ativo', false) == true;
    }

    // Admin = admin raiz OU um superintendente ativo cujo próprio documento
    // tem role == 'admin'. Como só admins podem escrever na coleção
    // `superintendentes` (ver match abaixo), ninguém consegue setar esse
    // campo em si mesmo — a única forma de virar admin é um admin existente
    // conceder isso explicitamente.
    // Meu próprio role — só tem sentido quando isRegisteredSuperintendent().
    function myRole() {
      return isActiveSuperintendent() ? superintendentDoc().data.get('role', 'superintendent') : null;
    }

    // "Admin" cobre TANTO o admin raiz (bootstrap/recuperação, identidade
    // fixa) QUANTO qualquer superintendente ativo cadastrado com
    // role: 'admin'. Para ações fora da coleção `superintendentes` (schools,
    // turmas, grades, visitas), os dois têm o mesmo poder. Dentro de
    // `superintendentes`, o admin cadastrado (não-raiz) tem poderes mais
    // restritos — ver o match dessa coleção abaixo.
    function isAdmin() {
      return isPlatformAdmin() || (isActiveSuperintendent() && myRole() == 'admin');
    }

    // Verdadeiro só para o e-mail fixo do admin raiz — usado para as
    // restrições que nem um admin cadastrado pode fazer (excluir usuários,
    // conceder/retirar role: admin, editar outro admin).
    function isRootEmailKey(emailKey) {
      return emailKey == 'fernandomariodasmartins@gmail.com';
    }

    // "Autorizado" = qualquer superintendente cadastrado e ativo, ou admin.
    function isAuthorized() {
      return isActiveSuperintendent() || isAdmin();
    }

    function myEscolas() {
      return isActiveSuperintendent() ? superintendentDoc().data.get('escolas', []) : [];
    }

    function canWriteEscola(escolaNome) {
      return isAdmin() || (isActiveSuperintendent() && escolaNome in myEscolas());
    }


    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Documentos de `superintendentes` são identificados por e-mail (contém
    // "@" e "."), então precisam de um formato de ID diferente de isValidId().
    function isValidEmailId(id) {
      return id is string && id.size() <= 150 &&
        id.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // --- Fase 2A — helpers compartilhados por school_years/enrollment_snapshots/imports/audit_logs ---

    function isValidAnoLetivo(ano) {
      return ano is int && ano >= 2000 && ano <= 2100;
    }

    function isNonNegInt(n) {
      return n is int && n >= 0;
    }

    function isValidMesReferencia(mes) {
      return mes is string && mes.matches('^[0-9]{4}-(0[1-9]|1[0-2])$');
    }

    // O ano (prefixo YYYY) de mesReferencia precisa bater com anoLetivo —
    // mesmo requisito de src/lib/enrollmentCalculations.ts
    // (isMonthWithinSchoolYear). Só chamar depois de isValidMesReferencia()
    // já ter confirmado o formato.
    function isMesReferenciaWithinAnoLetivo(mes, ano) {
      return mes[0:4] == string(ano);
    }

    // `imports` só tem schoolId/codInep (sem escolaNome — ver seção 15 do
    // plano), então a autorização por escola precisa de um lookup no
    // documento real de `schools` em vez de canWriteEscola() direto.
    function schoolNomeById(schoolId) {
      return get(/databases/$(database)/documents/schools/$(schoolId)).data.nome;
    }

    // schoolId is string vem primeiro e de propósito: garante que
    // $(schoolId) nunca seja interpolado num path com um tipo inesperado,
    // mesmo que esta função seja chamada antes de outra validação de campo
    // (mesma ordem "autorização antes do shape" já usada em canWriteEscola()
    // para turmas/visitas).
    function canWriteSchoolById(schoolId) {
      return schoolId is string && (isAdmin() || (
        isActiveSuperintendent() &&
        exists(/databases/$(database)/documents/schools/$(schoolId)) &&
        schoolNomeById(schoolId) in myEscolas()
      ));
    }

    // Coleções cujos audit_logs são necessariamente de UMA escola (revisão
    // pós-PR #8, seção 11 do plano) — todo log dessas coleções exige
    // schoolId/codInep válidos e acesso à escola; logs de outras coleções
    // (ex.: superintendentes) não são "escolares" e não exigem escola.
    function isSchoolScopedAuditCollection(collectionName) {
      return collectionName in ['school_years', 'enrollment_snapshots', 'turmas', 'schools', 'imports'];
    }

    // codInep do audit_log precisa bater com o codInep REAL da escola —
    // mesmo princípio de isCanonicalSchoolMatch, só que audit_logs não tem
    // campo escolaNome no schema (só schoolId/codInep). Só é chamada depois
    // de canWriteSchoolById(schoolId) já ter confirmado que a escola existe
    // (mesmo padrão de curto-circuito usado nas outras funções acima).
    function isCanonicalCodInepForSchool(schoolId, codInep) {
      return get(/databases/$(database)/documents/schools/$(schoolId)).data.codInep == codInep;
    }

    // Integridade canônica na CRIAÇÃO de school_years/enrollment_snapshots
    // (revisão pós-PR #8): canWriteEscola(incoming().escolaNome) sozinho só
    // prova que o usuário pode escrever numa escola CHAMADA escolaNome — não
    // prova que schoolId/codInep/escolaNome no payload realmente descrevem a
    // MESMA escola. Sem isto, um superintendente da Escola A podia criar um
    // documento com schoolId da Escola B, desde que preenchesse escolaNome
    // com o nome da própria Escola A (que ele tem permissão de escrever).
    // Esta função fecha essa lacuna: exige que schoolId aponte para um
    // documento real de `schools` cujo codInep/nome batem EXATAMENTE com o
    // que o payload está declarando.
    //
    // Sem exists() de propósito (diferente de canWriteSchoolById acima): um
    // get() num path inexistente faz só essa cláusula `allow` falhar
    // (nega o acesso), não derruba a requisição — mesmo resultado prático
    // de negar a escrita, só que com 1 leitura em vez de 2. O emulador
    // local tem um limite de 1000 sub-expressões por avaliação de regra, e
    // enrollment_snapshots já soma canWriteEscola() + este helper + o de
    // turma no mesmo `allow create` — cada leitura a menos ajuda a caber
    // no orçamento (ver revisão pós-PR #8).
    function isCanonicalSchoolMatch(schoolId, codInep, escolaNome) {
      let school = get(/databases/$(database)/documents/schools/$(schoolId)).data;
      return school.nome == escolaNome && school.codInep == codInep;
    }

    // Integridade da turma referenciada por um enrollment_snapshot na
    // CRIAÇÃO: a turma precisa existir e pertencer à MESMA escola do
    // snapshot — nunca só por nome (ver revisão pós-PR #8, mesma
    // motivação de getClassroomsForSchool em src/lib/classService.ts).
    // Aceita tanto turma.schoolId (Fase 2A) quanto turma.escolaId (legado)
    // durante a compatibilidade — mas nunca aceita silenciosamente uma
    // turma sem NENHUM dos dois batendo. Mesmo motivo de
    // isCanonicalSchoolMatch para omitir exists().
    function isCanonicalTurmaOfSchool(turmaId, schoolId) {
      let turma = get(/databases/$(database)/documents/turmas/$(turmaId)).data;
      return turma.get('schoolId', '') == schoolId || turma.get('escolaId', '') == schoolId;
    }

    // --- Superintendentes ---
    // Hierarquia: admin raiz > admin cadastrado > superintendente comum.
    // Get: o próprio usuário lê seu registro, ou qualquer admin lê qualquer um.
    // List: qualquer admin (evita enumerar e-mails para não-admins).
    //
    // Payload válido, exigido em create/update, para todos os perfis:
    //  - só os campos id/nome/cargo/email/escolas/ativo/role (rejeita campo
    //    inesperado);
    //  - email (minúsculo) == ID do documento (não pode divergir);
    //  - ativo e role são obrigatórios (sem default) — força quem cria/edita
    //    a decidir explicitamente, e é o que barra documento incompleto;
    //  - role só pode ser 'admin' ou 'superintendent';
    //  - superintendent precisa de pelo menos 1 escola; admin pode ter
    //    escolas: [] porque tem acesso global (canWriteEscola/isAdmin).
    function isValidSuperintendentPayload(emailKey) {
      return incoming().keys().hasOnly(['id', 'nome', 'cargo', 'email', 'escolas', 'ativo', 'role']) &&
        incoming().id is string &&
        incoming().nome is string && incoming().nome.size() > 0 && incoming().nome.size() <= 150 &&
        incoming().cargo is string && incoming().cargo.size() <= 150 &&
        incoming().email is string && incoming().email.lower() == emailKey &&
        incoming().escolas is list &&
        incoming().ativo is bool &&
        incoming().role in ['admin', 'superintendent'] &&
        (incoming().role == 'admin' || incoming().escolas.size() >= 1);
    }

    match /superintendentes/{emailKey} {
      allow get: if isSignedIn() && (isAdmin() || myEmail() == emailKey);
      allow list: if isAdmin();

      // Create: qualquer admin cria, mas só o admin raiz pode criar outro
      // admin — admin cadastrado só cria role: 'superintendent'.
      allow create: if isAdmin() && isValidEmailId(emailKey) && isValidSuperintendentPayload(emailKey) &&
        (isPlatformAdmin() || incoming().role == 'superintendent');

      // Update:
      //  - admin raiz pode editar qualquer documento, inclusive outros
      //    admins e conceder/retirar role: admin — EXCETO o próprio
      //    documento, que nunca pode ser desativado/rebaixado por essa via
      //    (proteção contra autoexclusão de acesso, mesmo acidental);
      //  - admin cadastrado (não-raiz) só edita documentos que já são
      //    role: 'superintendent' E continuam role: 'superintendent' depois
      //    — não enxerga/edita outro admin, não promove ninguém, e como o
      //    próprio documento do admin cadastrado é role: 'admin', ele nunca
      //    bate nessa condição (não pode editar a si mesmo).
      allow update: if isAdmin() && isValidEmailId(emailKey) && isValidSuperintendentPayload(emailKey) &&
        (
          (isPlatformAdmin() &&
            (!isRootEmailKey(emailKey) || (incoming().ativo == true && incoming().role == 'admin'))) ||
          (isAdmin() && !isPlatformAdmin() &&
            resource.data.role == 'superintendent' && incoming().role == 'superintendent')
        );

      // Delete: só o admin raiz, e nunca o próprio documento do admin raiz —
      // admin cadastrado e superintendente comum não excluem ninguém.
      allow delete: if isPlatformAdmin() && isValidEmailId(emailKey) && !isRootEmailKey(emailKey);
    }

    // --- Schools ---
    match /schools/{schoolId} {
      allow read: if isAuthorized();
      allow create: if isAdmin() && isValidId(schoolId) &&
        incoming().nome is string && incoming().nome.size() <= 150 &&
        incoming().codInep is string && incoming().codInep.size() <= 50 &&
        incoming().cidade is string && incoming().cidade.size() <= 100 &&
        incoming().matriculas is number &&
        incoming().idebMedio is number &&
        incoming().metaIdeb is number &&
        incoming().status is string;
      allow update: if isAuthorized() && isValidId(schoolId) &&
        canWriteEscola(resource.data.nome) &&
        incoming().nome is string && incoming().nome.size() <= 150 &&
        incoming().codInep is string && incoming().codInep.size() <= 50 &&
        incoming().cidade is string && incoming().cidade.size() <= 100 &&
        incoming().matriculas is number &&
        incoming().idebMedio is number &&
        incoming().metaIdeb is number &&
        incoming().status is string;
      // Dado histórico/cadastral — sem exclusão livre, só admin raiz.
      allow delete: if isPlatformAdmin() && isValidId(schoolId);
    }

    // --- Turmas ---
    match /turmas/{turmaId} {
      allow read: if isAuthorized();
      allow create, update: if isAuthorized() && isValidId(turmaId) &&
        canWriteEscola(incoming().escolaNome) &&
        incoming().escolaId is string && incoming().escolaId.size() <= 128 &&
        incoming().escolaNome is string && incoming().escolaNome.size() <= 150 &&
        incoming().nome is string && incoming().nome.size() <= 100 &&
        incoming().ano is string && incoming().ano.size() <= 20 &&
        incoming().periodo is string && incoming().periodo.size() <= 50 &&
        incoming().alunosSinalizados is number;
      allow delete: if isAuthorized() && isValidId(turmaId) &&
        canWriteEscola(resource.data.escolaNome);
    }

    // --- Grades (Opção C — mitigação temporária, ver Fase 0) ---
    // grades ainda não tem schoolId; isolamento por escola fica para uma
    // migração posterior (docs/plano-migracao-grades-schoolId.md). Até lá,
    // isAuthorized() (superintendente ativo ou admin) é a mitigação — evita
    // leitura/escrita por conta não cadastrada, mas não isola por escola.
    match /grades/{gradeId} {
      allow read: if isAuthorized();
      allow create, update: if isAuthorized() && isValidId(gradeId) &&
        incoming().nome is string && incoming().nome.size() <= 150 &&
        incoming().turma is string && incoming().turma.size() <= 100 &&
        incoming().portugues is number &&
        incoming().matematica is number &&
        incoming().ciencias is number &&
        incoming().bimestre is string;
      allow delete: if isAdmin() && isValidId(gradeId);
    }

    // --- Visitas ---
    match /visitas/{visitaId} {
      allow read: if isAuthorized();
      allow create, update: if isAuthorized() && isValidId(visitaId) &&
        canWriteEscola(incoming().escola) &&
        incoming().escola is string && incoming().escola.size() <= 150 &&
        incoming().tecnico is string && incoming().tecnico.size() <= 150 &&
        incoming().data is string && incoming().data.size() <= 30 &&
        incoming().foco is string && incoming().foco.size() <= 200 &&
        incoming().status is string;
      allow delete: if isAuthorized() && isValidId(visitaId) &&
        canWriteEscola(resource.data.escola);
    }

    // Shape do documento, comum a create e update — a diferença entre os
    // dois (imutabilidade de id/schoolId/codInep/anoLetivo, autorização
    // sobre o dono ANTIGO do documento) fica só no match abaixo.
    function isValidSchoolYearShape(yearId) {
      return incoming().keys().hasOnly([
          'id', 'schoolId', 'codInep', 'escolaNome', 'anoLetivo',
          'matriculaInicial', 'matriculaAtual', 'quantidadeTurmasAtivas',
          'status', 'dataInicio', 'dataFim', 'ultimaAtualizacao',
          'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ]) &&
        incoming().id == yearId &&
        incoming().schoolId is string && incoming().schoolId.size() <= 128 &&
        incoming().codInep is string && incoming().codInep.size() <= 50 &&
        incoming().escolaNome is string && incoming().escolaNome.size() <= 150 &&
        isValidAnoLetivo(incoming().anoLetivo) &&
        // ID determinístico validado contra os campos internos (seção 5 do
        // plano: schoolId_anoLetivo) — impede um schoolId/anoLetivo no
        // payload que não bate com o próprio documentId.
        yearId == incoming().schoolId + '_' + string(incoming().anoLetivo) &&
        (incoming().matriculaInicial == null || isNonNegInt(incoming().matriculaInicial)) &&
        (incoming().matriculaAtual == null || isNonNegInt(incoming().matriculaAtual)) &&
        isNonNegInt(incoming().quantidadeTurmasAtivas) &&
        incoming().status in ['planejamento', 'ativo', 'encerrado', 'arquivado'] &&
        (incoming().dataInicio == null || (incoming().dataInicio is string && incoming().dataInicio.size() <= 30)) &&
        (!('dataFim' in incoming()) || incoming().dataFim == null || (incoming().dataFim is string && incoming().dataFim.size() <= 30)) &&
        incoming().ultimaAtualizacao is string &&
        incoming().createdAt is string && incoming().updatedAt is string &&
        incoming().createdBy is string && incoming().updatedBy is string;
    }

    // --- Fase 2A: school_years ---
    // Estrutura anual da escola. Os dados pertencem à escola+anoLetivo, não
    // ao superintendente (ver seção "Regra principal" do plano) — troca de
    // responsável não afeta estes documentos, só o vínculo em
    // superintendentes/{email}.escolas.
    match /school_years/{yearId} {
      // Baseado em schoolId (canWriteSchoolById), não em escolaNome: os
      // serviços desta fase sempre consultam school_years filtrando por
      // schoolId (ver SchoolYearService), e o Firestore só consegue provar
      // a segurança de uma consulta (list) quando a regra depende do MESMO
      // campo usado no where() da consulta — uma regra baseada em
      // escolaNome nunca seria aprovada para uma consulta filtrada por
      // schoolId, mesmo quando o dado real bateria. .get(..., '') evita
      // erro de avaliação contra o documento hipotético sem o campo.
      allow read: if canWriteSchoolById(resource.data.get('schoolId', ''));

      // isCanonicalSchoolMatch (revisão pós-PR #8) fecha a lacuna de
      // canWriteEscola(incoming().escolaNome) sozinho: prova não só que o
      // usuário PODE escrever numa escola com esse nome, mas que
      // schoolId/codInep/escolaNome do payload realmente descrevem a MESMA
      // escola em `schools` — sem isso, a Escola A podia criar um
      // school_year com o schoolId real da Escola B só preenchendo
      // escolaNome com o próprio nome (que ela tem permissão de escrever).
      // isAuthorized() sai daqui de propósito (mesmo motivo do update
      // logo abaixo): canWriteEscola() já implica isAuthorized(), e cada
      // chamada extra a isAdmin()/isActiveSuperintendent() pesa no limite
      // de 1000 sub-expressões do emulador local.
      allow create: if isValidId(yearId) &&
        canWriteEscola(incoming().escolaNome) &&
        isCanonicalSchoolMatch(incoming().schoolId, incoming().codInep, incoming().escolaNome) &&
        isValidSchoolYearShape(yearId);

      // create/update SEPARADOS de propósito (ver revisão pré-PR): a versão
      // anterior usava canWriteEscola(incoming().escolaNome) para os dois,
      // o que autorizava um update olhando só para o payload NOVO — um
      // superintendente da Escola B podia sequestrar o documento existente
      // da Escola A bastando enviar escolaNome/schoolId da própria Escola B
      // no update. Agora update exige acesso à escola JÁ DONA do documento
      // (resource.data.escolaNome — um único canWriteEscola(), não dois: o
      // emulador local estoura o limite de expressões ao avaliar isAdmin()
      // repetidas vezes na mesma regra) e trava id/schoolId/codInep/
      // anoLetivo/escolaNome como imutáveis — o ano letivo de um registro
      // nunca muda para "virar" outro registro, e isAuthorized() sai daqui
      // de propósito porque canWriteEscola() já implica isAuthorized().
      // createdAt/createdBy também travados (revisão pós-PR #8): sem isso,
      // um update podia reescrever a autoria/data de criação originais.
      allow update: if isValidId(yearId) &&
        canWriteEscola(resource.data.escolaNome) &&
        incoming().schoolId == resource.data.schoolId &&
        incoming().codInep == resource.data.codInep &&
        incoming().anoLetivo == resource.data.anoLetivo &&
        incoming().escolaNome == resource.data.escolaNome &&
        incoming().createdAt == resource.data.createdAt &&
        incoming().createdBy == resource.data.createdBy &&
        isValidSchoolYearShape(yearId);

      // Sem exclusão livre — igual a `schools`, o histórico anual só é
      // arquivado (status: 'arquivado'), nunca apagado por um usuário comum.
      allow delete: if isPlatformAdmin() && isValidId(yearId);
    }

    // Shape do documento, comum a create e update — mesma separação de
    // responsabilidade de isValidSchoolYearShape() acima.
    function isValidEnrollmentSnapshotShape(snapshotId) {
      return incoming().keys().hasOnly([
          'id', 'schoolId', 'codInep', 'escolaNome', 'turmaId', 'turmaNome',
          'anoLetivo', 'mesReferencia', 'matriculaInicioMes', 'novasMatriculas',
          'transferenciasEntrada', 'transferenciasSaida', 'abandono', 'outrasSaidas',
          'matriculaFimMes', 'observacao', 'reviewStatus',
          'sourceSystem', 'sourceReportType', 'sourceReportTitle', 'sourceFileName',
          'sourceGeneratedAt', 'sourceFileHash', 'importBatchId',
          'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ]) &&
        incoming().id == snapshotId &&
        incoming().schoolId is string && incoming().schoolId.size() <= 128 &&
        incoming().codInep is string && incoming().codInep.size() <= 50 &&
        incoming().escolaNome is string && incoming().escolaNome.size() <= 150 &&
        incoming().turmaId is string && incoming().turmaId.size() <= 128 &&
        incoming().turmaNome is string && incoming().turmaNome.size() <= 150 &&
        isValidAnoLetivo(incoming().anoLetivo) &&
        isValidMesReferencia(incoming().mesReferencia) &&
        isMesReferenciaWithinAnoLetivo(incoming().mesReferencia, incoming().anoLetivo) &&
        // ID determinístico validado contra os campos internos (seção 7 do
        // plano: schoolId_turmaId_mesReferencia).
        snapshotId == incoming().schoolId + '_' + incoming().turmaId + '_' + incoming().mesReferencia &&
        isNonNegInt(incoming().matriculaInicioMes) &&
        isNonNegInt(incoming().novasMatriculas) &&
        isNonNegInt(incoming().transferenciasEntrada) &&
        isNonNegInt(incoming().transferenciasSaida) &&
        isNonNegInt(incoming().abandono) &&
        isNonNegInt(incoming().outrasSaidas) &&
        isNonNegInt(incoming().matriculaFimMes) &&
        incoming().reviewStatus in ['manual', 'importado_pendente', 'confirmado', 'divergencia', 'corrigido'] &&
        incoming().createdAt is string && incoming().updatedAt is string &&
        incoming().createdBy is string && incoming().updatedBy is string;
    }

    // --- Fase 2A: enrollment_snapshots ---
    // Matrícula mensal por turma. Imutável por mês: o ID determinístico
    // (schoolId_turmaId_YYYY-MM) garante que corrigir um mês nunca sobrescreve
    // outro. Exclusão comum bloqueada (seção "Histórico" do plano).
    match /enrollment_snapshots/{snapshotId} {
      // Ver comentário equivalente em school_years — baseado em schoolId
      // (o campo que EnrollmentSnapshotService realmente usa no where() de
      // listEnrollmentSnapshotsForSchool), não em escolaNome.
      allow read: if canWriteSchoolById(resource.data.get('schoolId', ''));

      // isCanonicalSchoolMatch/isCanonicalTurmaOfSchool (revisão pós-PR #8):
      // mesma lacuna de school_years, mais a integridade da turma —
      // canWriteEscola(incoming().escolaNome) sozinho não provava que
      // turmaId pertence à MESMA escola do snapshot, nem que schoolId
      // aponta para a escola que escolaNome diz ser. isAuthorized() sai
      // daqui de propósito (mesmo motivo de school_years — canWriteEscola()
      // já implica isAuthorized(), e o emulador local tem um limite de 1000
      // sub-expressões por avaliação de regra).
      allow create: if isValidId(snapshotId) &&
        canWriteEscola(incoming().escolaNome) &&
        isCanonicalSchoolMatch(incoming().schoolId, incoming().codInep, incoming().escolaNome) &&
        isCanonicalTurmaOfSchool(incoming().turmaId, incoming().schoolId) &&
        isValidEnrollmentSnapshotShape(snapshotId);

      // Update = correção do MESMO mês/turma/escola (ver seção "Histórico"
      // do plano) — nunca uma forma de mudar de escola/turma/mês mantendo o
      // ID. Mesma correção de segurança/desempenho de school_years: um só
      // canWriteEscola() sobre o dono ANTIGO do documento (não dois — ver
      // comentário em school_years sobre o limite de expressões do
      // emulador), schoolId/turmaId/anoLetivo/mesReferencia/escolaNome
      // travados como imutáveis, isAuthorized() removido por já estar
      // implícito em canWriteEscola(). createdAt/createdBy também travados
      // (revisão pós-PR #8), mesmo motivo de school_years.
      allow update: if isValidId(snapshotId) &&
        canWriteEscola(resource.data.escolaNome) &&
        incoming().schoolId == resource.data.schoolId &&
        incoming().turmaId == resource.data.turmaId &&
        incoming().anoLetivo == resource.data.anoLetivo &&
        incoming().escolaNome == resource.data.escolaNome &&
        incoming().mesReferencia == resource.data.mesReferencia &&
        incoming().createdAt == resource.data.createdAt &&
        incoming().createdBy == resource.data.createdBy &&
        isValidEnrollmentSnapshotShape(snapshotId);

      allow delete: if isPlatformAdmin() && isValidId(snapshotId);
    }

    // --- Fase 2A: imports ---
    // Sem escolaNome no schema (seção 15) — autorização por escola faz
    // lookup em `schools/{schoolId}` via canWriteSchoolById(). Todo import
    // nasce em 'analisando' ou 'aguardando_confirmacao': nunca é possível
    // CRIAR um documento já 'confirmado'/'processado' por esta via.
    match /imports/{importId} {
      // Mesma restrição por escola de canAccessEscola(), via lookup por
      // schoolId (ver canWriteSchoolById — imports não tem escolaNome).
      // .get() com default pelo mesmo motivo do comentário em school_years.
      allow read: if canWriteSchoolById(resource.data.get('schoolId', ''));
      allow create: if isAuthorized() && isValidId(importId) &&
        incoming().schoolId is string &&
        // Checagem de integridade, independente de autorização: mesmo um
        // admin não pode criar um import apontando para um schoolId que não
        // existe em `schools` (seção 23 do plano — "importação sem escola
        // válida rejeitada").
        exists(/databases/$(database)/documents/schools/$(incoming().schoolId)) &&
        canWriteSchoolById(incoming().schoolId) &&
        incoming().status in ['analisando', 'aguardando_confirmacao'] &&
        incoming().keys().hasOnly([
          'id', 'sourceSystem', 'reportType', 'reportTitle', 'fileName', 'fileHash',
          'schoolId', 'codInep', 'anoLetivo', 'mesReferencia', 'bimestre',
          'recordsRead', 'recordsCreated', 'recordsUpdated', 'recordsIgnored',
          'inconsistencies', 'status', 'preview',
          'createdAt', 'confirmedAt', 'processedAt', 'createdBy', 'confirmedBy'
        ]) &&
        incoming().id is string &&
        incoming().sourceSystem in ['Manual', 'SIGE Escola', 'SIGAE', 'Importação administrativa', 'Migração'] &&
        incoming().reportType is string && incoming().reportType.size() <= 150 &&
        incoming().reportTitle is string && incoming().reportTitle.size() <= 200 &&
        incoming().fileName is string && incoming().fileName.size() <= 260 &&
        incoming().fileHash is string && incoming().fileHash.size() <= 128 &&
        incoming().schoolId is string && incoming().schoolId.size() <= 128 &&
        incoming().codInep is string && incoming().codInep.size() <= 50 &&
        // ID determinístico validado contra os campos internos (mesmo
        // padrão de school_years/enrollment_snapshots — ver
        // buildImportId em src/lib/importService.ts: schoolId_fileHash).
        importId == incoming().schoolId + '_' + incoming().fileHash &&
        incoming().id == importId &&
        isValidAnoLetivo(incoming().anoLetivo) &&
        isNonNegInt(incoming().recordsRead) &&
        isNonNegInt(incoming().recordsCreated) &&
        isNonNegInt(incoming().recordsUpdated) &&
        isNonNegInt(incoming().recordsIgnored) &&
        incoming().inconsistencies is list &&
        incoming().createdAt is string &&
        incoming().createdBy is string;
      // Update cobre tanto reprocessar o preview quanto confirmar/avançar o
      // status — em ambos os casos exige poder escrever na MESMA escola do
      // import (admin, ou o superintendente vinculado a ela). Um
      // superintendente sem vínculo àquela escola nunca confirma o import
      // (seção 19 do plano).
      // A escola do import nunca muda por update (só um novo import aponta
      // para outra escola) — comparar por igualdade em vez de chamar
      // canWriteSchoolById() duas vezes evita duplicar toda a cadeia de
      // get()/exists() interna e estourar o limite de expressões do
      // emulador local em avaliações mais profundas.
      // id/codInep/anoLetivo/fileHash/createdAt/createdBy travados como
      // imutáveis (revisão pós-PR #8) — update é só para reprocessar o
      // preview/avançar o status, nunca para reescrever de qual arquivo ou
      // ano letivo o import veio, nem sua autoria original.
      allow update: if isAuthorized() && isValidId(importId) &&
        incoming().schoolId == resource.data.get('schoolId', '') &&
        canWriteSchoolById(incoming().schoolId) &&
        incoming().keys().hasOnly([
          'id', 'sourceSystem', 'reportType', 'reportTitle', 'fileName', 'fileHash',
          'schoolId', 'codInep', 'anoLetivo', 'mesReferencia', 'bimestre',
          'recordsRead', 'recordsCreated', 'recordsUpdated', 'recordsIgnored',
          'inconsistencies', 'status', 'preview',
          'createdAt', 'confirmedAt', 'processedAt', 'createdBy', 'confirmedBy'
        ]) &&
        incoming().id == resource.data.id &&
        incoming().codInep == resource.data.codInep &&
        incoming().anoLetivo == resource.data.anoLetivo &&
        incoming().fileHash == resource.data.fileHash &&
        incoming().createdAt == resource.data.createdAt &&
        incoming().createdBy == resource.data.createdBy &&
        incoming().status in [
          'analisando', 'aguardando_confirmacao', 'confirmado',
          'processado', 'processado_com_alertas', 'cancelado', 'erro'
        ] &&
        isNonNegInt(incoming().recordsRead) &&
        isNonNegInt(incoming().recordsCreated) &&
        isNonNegInt(incoming().recordsUpdated) &&
        isNonNegInt(incoming().recordsIgnored);
      allow delete: if isPlatformAdmin() && isValidId(importId);
    }

    // --- Fase 2A: audit_logs ---
    // Somente-criação por design: update/delete sempre bloqueados, inclusive
    // para admin — uma trilha de auditoria que pode ser editada não serve
    // para nada. userEmail precisa bater com quem está autenticado, para que
    // ninguém grave um log em nome de outra pessoa.
    //
    // Revisão pós-PR #8 (seção 11 do plano): logs de coleções escolares
    // (isSchoolScopedAuditCollection) agora exigem schoolId/codInep válidos
    // — escola existente, codInep canônico, e o autor precisa ter acesso de
    // escrita àquela escola (canWriteSchoolById, que já implica
    // isAuthorized()) — nunca um log escolar apontando para a carteira de
    // outro superintendente. Logs de coleções não-escolares continuam só
    // exigindo isAuthorized().
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isValidId(logId) &&
        incoming().keys().hasOnly([
          'id', 'collectionName', 'documentId', 'schoolId', 'codInep', 'anoLetivo',
          'operation', 'previousValue', 'newValue', 'source', 'importBatchId',
          'userId', 'userEmail', 'timestamp'
        ]) &&
        incoming().id is string &&
        incoming().collectionName is string && incoming().collectionName.size() <= 100 &&
        incoming().documentId is string && incoming().documentId.size() <= 200 &&
        incoming().operation in ['create', 'update', 'archive', 'import', 'correction'] &&
        incoming().source in ['Manual', 'SIGE Escola', 'SIGAE', 'Importação administrativa', 'Migração'] &&
        incoming().userId is string &&
        incoming().userEmail is string && incoming().userEmail.lower() == myEmail() &&
        incoming().timestamp is string &&
        (
          isSchoolScopedAuditCollection(incoming().collectionName)
            ? (
                incoming().schoolId is string &&
                canWriteSchoolById(incoming().schoolId) &&
                incoming().codInep is string &&
                isCanonicalCodInepForSchool(incoming().schoolId, incoming().codInep)
              )
            : isAuthorized()
        );
      allow update, delete: if false;
    }
  }
}
