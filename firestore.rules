rules_version = '2';

// ============================================================================
// REGRAS OFICIAIS DE PRODUÇÃO — publicadas na Fase 1F (promovidas a partir
// de firestore.rules.proposed, revisado e aprovado nas Fases 0/1C/1D/1E).
// firestore.rules.proposed foi removido do repositório após a publicação —
// esta é a única fonte de verdade de regras de segurança do projeto.
//
// Problema que estas regras corrigem (versão anterior a Fase 1F): a leitura
// de schools/turmas/grades/visitas exigia apenas isSignedIn() — qualquer
// conta Google autenticada, mesmo nunca cadastrada como superintendente,
// conseguia ler nomes e notas de alunos. As regras de ESCRITA já eram
// corretamente restritas a superintendentes cadastrados (via
// myEscolas()/canWriteEscola()) — só a leitura estava aberta demais.
//
// Mudança de schema (Fase 0 + Fase 1C):
//   - superintendentes/{email} ganha os campos OBRIGATÓRIOS `ativo: boolean`
//     e `role: 'admin' | 'superintendent'` (sem default — create/update
//     exigem os dois explicitamente).
//   - FAIL-CLOSED: um documento SEM `ativo`, ou com `ativo: false`, é tratado
//     como NÃO autorizado. O admin raiz (isPlatformAdmin(), checado só por
//     e-mail, sem depender do documento) continua com acesso mesmo assim,
//     mas qualquer OUTRO superintendente cadastrado sem o campo `ativo`
//     FICARÁ BLOQUEADO até rodar scripts/migrate-ativo-field.mjs.
//   - HIERARQUIA (Fase 1C): admin raiz > admin cadastrado (role: 'admin',
//     não-raiz) > superintendente comum (role: 'superintendent'). Admin
//     cadastrado só cria/edita superintendentes comuns — não pode criar
//     outro admin, promover ninguém, editar outro admin, nem excluir
//     ninguém. Só o admin raiz concede/retira role: 'admin' e exclui
//     usuários; o próprio documento do admin raiz nunca pode ser
//     desativado, rebaixado ou excluído, nem por ele mesmo.
//   `src/components/SuperintendentesView.tsx` e `src/lib/superintendentService.ts`
//   já foram atualizados na Fase 1C para enviar `ativo`/`role` e respeitar
//   essa hierarquia — ver relatório da Fase 1C para o estado exato.
//
// LIMITAÇÃO CONHECIDA (ver auditoria, item "riscos restantes"):
//   A coleção `grades` não tem campo escolaNome/escolaId no schema atual
//   (o campo `turma` é um nome de exibição como "3º Ano A - Matutino", que
//   SE REPETE entre escolas diferentes nos dados de exemplo — não é uma
//   chave confiável para localizar a escola dona da nota via lookup em
//   `turmas`). Por isso não é possível aplicar aqui o princípio de menor
//   privilégio por escola em `grades` sem alterar o formato de dados
//   (fora do escopo pedido) ou mexer em NotasView.tsx (também fora do
//   escopo pedido). Como mitigação parcial, `grades` fica restrito a
//   superintendentes cadastrados e ativos (fecha o buraco de "qualquer
//   conta Google"), mas não é isolado por escola. Ver recomendação no
//   relatório para uma fase futura.
//
// FASE 2A — adição (sem alterar nenhuma regra acima): school_years,
// enrollment_snapshots, imports e audit_logs. Mesmo modelo de autorização já
// usado por schools/turmas (isAuthorized() para leitura, canWriteEscola()
// para escrita por nome de escola), com hasOnly() nos quatro para rejeitar
// campo inesperado — mais estrito que schools/turmas/grades/visitas (que não
// usam hasOnly), porque são coleções novas sem dado legado a acomodar.
// audit_logs é somente-criação: update/delete sempre bloqueados, mesmo para
// admin, para que a trilha de auditoria nunca possa ser alterada depois de
// gravada.
//
// FASE 2C.1 — correção de escopo: "Notas Bimestrais" deixa de ser um
// cadastro nominal de estudantes e passa a ser o acompanhamento AGREGADO,
// por escola+turma+ano letivo+bimestre, do preenchimento de notas que a
// escola já faz no SIGE Escola (ver
// docs/descontinuacao-prototipo-notas-nominais.md). `student_rosters` e
// `student_bimester_grades` são fechadas com o mesmo padrão já usado pela
// coleção `grades` (legado anterior): só admin raiz lê, create/update/
// delete bloqueados para todos — nenhum documento existente é excluído ou
// migrado. A nova coleção `grade_entry_monitoring` nunca contém nome,
// matrícula, CPF ou nota individual de estudante.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Barreira global: nega tudo que não casar com uma regra específica abaixo.
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return isSignedIn() && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : null;
    }

    // Admin "raiz"/break-glass: identidade explícita, não é checagem de
    // domínio de e-mail (@seduc.ce.gov.br não é usado como autorização).
    function isPlatformAdmin() {
      return isSignedIn() && myEmail() == 'fernandomariodasmartins@gmail.com';
    }

    function superintendentDoc() {
      return get(/databases/$(database)/documents/superintendentes/$(myEmail()));
    }

    function isRegisteredSuperintendent() {
      return isSignedIn() && myEmail() != null &&
        exists(/databases/$(database)/documents/superintendentes/$(myEmail()));
    }

    // FAIL-CLOSED: `ativo` ausente ou false == não autorizado. Só um
    // documento com `ativo == true` explícito passa. Isso exige rodar a
    // migração (scripts/migrate-ativo-field.mjs) antes de publicar estas
    // regras, senão superintendentes existentes ficam bloqueados.
    function isActiveSuperintendent() {
      return isRegisteredSuperintendent() &&
        superintendentDoc().data.get('ativo', false) == true;
    }

    // Admin = admin raiz OU um superintendente ativo cujo próprio documento
    // tem role == 'admin'. Como só admins podem escrever na coleção
    // `superintendentes` (ver match abaixo), ninguém consegue setar esse
    // campo em si mesmo — a única forma de virar admin é um admin existente
    // conceder isso explicitamente.
    // Meu próprio role — só tem sentido quando isRegisteredSuperintendent().
    function myRole() {
      return isActiveSuperintendent() ? superintendentDoc().data.get('role', 'superintendent') : null;
    }

    // "Admin" cobre TANTO o admin raiz (bootstrap/recuperação, identidade
    // fixa) QUANTO qualquer superintendente ativo cadastrado com
    // role: 'admin'. Para ações fora da coleção `superintendentes` (schools,
    // turmas, grades, visitas), os dois têm o mesmo poder. Dentro de
    // `superintendentes`, o admin cadastrado (não-raiz) tem poderes mais
    // restritos — ver o match dessa coleção abaixo.
    function isAdmin() {
      return isPlatformAdmin() || (isActiveSuperintendent() && myRole() == 'admin');
    }

    // Verdadeiro só para o e-mail fixo do admin raiz — usado para as
    // restrições que nem um admin cadastrado pode fazer (excluir usuários,
    // conceder/retirar role: admin, editar outro admin).
    function isRootEmailKey(emailKey) {
      return emailKey == 'fernandomariodasmartins@gmail.com';
    }

    // "Autorizado" = qualquer superintendente cadastrado e ativo, ou admin.
    function isAuthorized() {
      return isActiveSuperintendent() || isAdmin();
    }

    function myEscolas() {
      return isActiveSuperintendent() ? superintendentDoc().data.get('escolas', []) : [];
    }

    function canWriteEscola(escolaNome) {
      return isAdmin() || (isActiveSuperintendent() && escolaNome in myEscolas());
    }


    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Documentos de `superintendentes` são identificados por e-mail (contém
    // "@" e "."), então precisam de um formato de ID diferente de isValidId().
    function isValidEmailId(id) {
      return id is string && id.size() <= 150 &&
        id.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // --- Fase 2A — helpers compartilhados por school_years/enrollment_snapshots/imports/audit_logs ---

    function isValidAnoLetivo(ano) {
      return ano is int && ano >= 2000 && ano <= 2100;
    }

    function isNonNegInt(n) {
      return n is int && n >= 0;
    }

    function isValidMesReferencia(mes) {
      return mes is string && mes.matches('^[0-9]{4}-(0[1-9]|1[0-2])$');
    }

    // O ano (prefixo YYYY) de mesReferencia precisa bater com anoLetivo —
    // mesmo requisito de src/lib/enrollmentCalculations.ts
    // (isMonthWithinSchoolYear). Só chamar depois de isValidMesReferencia()
    // já ter confirmado o formato.
    function isMesReferenciaWithinAnoLetivo(mes, ano) {
      return mes[0:4] == string(ano);
    }

    // `imports` só tem schoolId/codInep (sem escolaNome — ver seção 15 do
    // plano), então a autorização por escola precisa de um lookup no
    // documento real de `schools` em vez de canWriteEscola() direto.
    function schoolNomeById(schoolId) {
      return get(/databases/$(database)/documents/schools/$(schoolId)).data.nome;
    }

    // schoolId is string vem primeiro e de propósito: garante que
    // $(schoolId) nunca seja interpolado num path com um tipo inesperado,
    // mesmo que esta função seja chamada antes de outra validação de campo
    // (mesma ordem "autorização antes do shape" já usada em canWriteEscola()
    // para turmas/visitas).
    function canWriteSchoolById(schoolId) {
      return schoolId is string && (isAdmin() || (
        isActiveSuperintendent() &&
        exists(/databases/$(database)/documents/schools/$(schoolId)) &&
        schoolNomeById(schoolId) in myEscolas()
      ));
    }

    // Coleções cujos audit_logs são necessariamente de UMA escola (revisão
    // pós-PR #8, seção 11 do plano) — todo log dessas coleções exige
    // schoolId/codInep válidos e acesso à escola; logs de outras coleções
    // (ex.: superintendentes) não são "escolares" e não exigem escola.
    function isSchoolScopedAuditCollection(collectionName) {
      return collectionName in [
        'school_years', 'enrollment_snapshots', 'turmas', 'schools', 'imports',
        'school_flow_results', 'grade_entry_monitoring'
      ];
    }

    // codInep do audit_log precisa bater com o codInep REAL da escola —
    // mesmo princípio de isCanonicalSchoolMatch, só que audit_logs não tem
    // campo escolaNome no schema (só schoolId/codInep). Só é chamada depois
    // de canWriteSchoolById(schoolId) já ter confirmado que a escola existe
    // (mesmo padrão de curto-circuito usado nas outras funções acima).
    function isCanonicalCodInepForSchool(schoolId, codInep) {
      return get(/databases/$(database)/documents/schools/$(schoolId)).data.codInep == codInep;
    }

    // Integridade canônica na CRIAÇÃO de school_years/enrollment_snapshots
    // (revisão pós-PR #8): canWriteEscola(incoming().escolaNome) sozinho só
    // prova que o usuário pode escrever numa escola CHAMADA escolaNome — não
    // prova que schoolId/codInep/escolaNome no payload realmente descrevem a
    // MESMA escola. Sem isto, um superintendente da Escola A podia criar um
    // documento com schoolId da Escola B, desde que preenchesse escolaNome
    // com o nome da própria Escola A (que ele tem permissão de escrever).
    // Esta função fecha essa lacuna: exige que schoolId aponte para um
    // documento real de `schools` cujo codInep/nome batem EXATAMENTE com o
    // que o payload está declarando.
    //
    // Sem exists() de propósito (diferente de canWriteSchoolById acima): um
    // get() num path inexistente faz só essa cláusula `allow` falhar
    // (nega o acesso), não derruba a requisição — mesmo resultado prático
    // de negar a escrita, só que com 1 leitura em vez de 2. O emulador
    // local tem um limite de 1000 sub-expressões por avaliação de regra, e
    // enrollment_snapshots já soma canWriteEscola() + este helper + o de
    // turma no mesmo `allow create` — cada leitura a menos ajuda a caber
    // no orçamento (ver revisão pós-PR #8).
    function isCanonicalSchoolMatch(schoolId, codInep, escolaNome) {
      let school = get(/databases/$(database)/documents/schools/$(schoolId)).data;
      return school.nome == escolaNome && school.codInep == codInep;
    }

    // Integridade da turma referenciada por um enrollment_snapshot na
    // CRIAÇÃO: a turma precisa existir e pertencer à MESMA escola do
    // snapshot — nunca só por nome (ver revisão pós-PR #8, mesma
    // motivação de getClassroomsForSchool em src/lib/classService.ts).
    // Aceita tanto turma.schoolId (Fase 2A) quanto turma.escolaId (legado)
    // durante a compatibilidade — mas nunca aceita silenciosamente uma
    // turma sem NENHUM dos dois batendo. Mesmo motivo de
    // isCanonicalSchoolMatch para omitir exists().
    function isCanonicalTurmaOfSchool(turmaId, schoolId) {
      let turma = get(/databases/$(database)/documents/turmas/$(turmaId)).data;
      return turma.get('schoolId', '') == schoolId || turma.get('escolaId', '') == schoolId;
    }

    // Mesma integridade de isCanonicalTurmaOfSchool, mais o ano letivo
    // (revisão do PR #15, Fase 2C; reaproveitada por grade_entry_monitoring
    // na Fase 2C.1): uma turma de OUTRO ano letivo não pode "colar"
    // silenciosamente só porque pertence à escola certa — sem isso, um
    // acompanhamento de 2026 podia acabar apontando para uma turma de 2025.
    // turma.get('anoLetivo', null) sem default numérico de propósito: uma
    // turma legada, ainda sem o campo (Fase 2A nunca migrou todo o
    // histórico), nunca é aceita silenciosamente — precisa ser completada em
    // Gestão de Escolas antes de existir para o módulo de notas.
    function isCanonicalTurmaOfSchoolYear(turmaId, schoolId, anoLetivo) {
      let turma = get(/databases/$(database)/documents/turmas/$(turmaId)).data;
      return (turma.get('schoolId', '') == schoolId || turma.get('escolaId', '') == schoolId) &&
        turma.get('anoLetivo', null) == anoLetivo;
    }

    // Mesma integridade de isCanonicalTurmaOfSchoolYear, mais o nome exibido
    // da turma (revisão do code review do PR #17, seção 3): sem esta
    // checagem, um create de grade_entry_monitoring podia informar um
    // turmaId/schoolId/anoLetivo corretos mas um turmaNome adulterado (ou
    // com diferença de caixa/espaço), divergindo do nome real cadastrado em
    // `turmas` sem que nenhuma regra barrasse — só isCanonicalTurmaOfSchoolYear
    // (sem checar nome) era usado no create. Comparação por igualdade
    // estrita de string: turma.get('nome', '') == turmaNome NÃO tolera
    // diferença de caixa nem espaço, de propósito — o nome recebido precisa
    // bater exatamente com o documento em `turmas`, nunca "parecido".
    // Função própria (não uma variação por parâmetro opcional) para não
    // alterar o comportamento dos outros usos existentes de
    // isCanonicalTurmaOfSchoolYear (student_rosters) e para fazer só UM
    // get() de `turmas` — mesmo orçamento de leitura, checagem extra sem
    // custo adicional de sub-expressão de rede.
    function isCanonicalTurmaOfSchoolYearAndName(turmaId, schoolId, anoLetivo, turmaNome) {
      let turma = get(/databases/$(database)/documents/turmas/$(turmaId)).data;
      return (turma.get('schoolId', '') == schoolId || turma.get('escolaId', '') == schoolId) &&
        turma.get('anoLetivo', null) == anoLetivo &&
        turma.get('nome', '') == turmaNome;
    }

    // --- Superintendentes ---
    // Hierarquia: admin raiz > admin cadastrado > superintendente comum.
    // Get: o próprio usuário lê seu registro, ou qualquer admin lê qualquer um.
    // List: qualquer admin (evita enumerar e-mails para não-admins).
    //
    // Payload válido, exigido em create/update, para todos os perfis:
    //  - só os campos id/nome/cargo/email/escolas/ativo/role (rejeita campo
    //    inesperado);
    //  - email (minúsculo) == ID do documento (não pode divergir);
    //  - ativo e role são obrigatórios (sem default) — força quem cria/edita
    //    a decidir explicitamente, e é o que barra documento incompleto;
    //  - role só pode ser 'admin' ou 'superintendent';
    //  - superintendent precisa de pelo menos 1 escola; admin pode ter
    //    escolas: [] porque tem acesso global (canWriteEscola/isAdmin).
    function isValidSuperintendentPayload(emailKey) {
      return incoming().keys().hasOnly(['id', 'nome', 'cargo', 'email', 'escolas', 'ativo', 'role']) &&
        incoming().id is string &&
        incoming().nome is string && incoming().nome.size() > 0 && incoming().nome.size() <= 150 &&
        incoming().cargo is string && incoming().cargo.size() <= 150 &&
        incoming().email is string && incoming().email.lower() == emailKey &&
        incoming().escolas is list &&
        incoming().ativo is bool &&
        incoming().role in ['admin', 'superintendent'] &&
        (incoming().role == 'admin' || incoming().escolas.size() >= 1);
    }

    match /superintendentes/{emailKey} {
      allow get: if isSignedIn() && (isAdmin() || myEmail() == emailKey);
      allow list: if isAdmin();

      // Create: qualquer admin cria, mas só o admin raiz pode criar outro
      // admin — admin cadastrado só cria role: 'superintendent'.
      allow create: if isAdmin() && isValidEmailId(emailKey) && isValidSuperintendentPayload(emailKey) &&
        (isPlatformAdmin() || incoming().role == 'superintendent');

      // Update:
      //  - admin raiz pode editar qualquer documento, inclusive outros
      //    admins e conceder/retirar role: admin — EXCETO o próprio
      //    documento, que nunca pode ser desativado/rebaixado por essa via
      //    (proteção contra autoexclusão de acesso, mesmo acidental);
      //  - admin cadastrado (não-raiz) só edita documentos que já são
      //    role: 'superintendent' E continuam role: 'superintendent' depois
      //    — não enxerga/edita outro admin, não promove ninguém, e como o
      //    próprio documento do admin cadastrado é role: 'admin', ele nunca
      //    bate nessa condição (não pode editar a si mesmo).
      allow update: if isAdmin() && isValidEmailId(emailKey) && isValidSuperintendentPayload(emailKey) &&
        (
          (isPlatformAdmin() &&
            (!isRootEmailKey(emailKey) || (incoming().ativo == true && incoming().role == 'admin'))) ||
          (isAdmin() && !isPlatformAdmin() &&
            resource.data.role == 'superintendent' && incoming().role == 'superintendent')
        );

      // Delete: só o admin raiz, e nunca o próprio documento do admin raiz —
      // admin cadastrado e superintendente comum não excluem ninguém.
      allow delete: if isPlatformAdmin() && isValidEmailId(emailKey) && !isRootEmailKey(emailKey);
    }

    // --- Schools ---
    match /schools/{schoolId} {
      allow read: if isAuthorized();
      allow create: if isAdmin() && isValidId(schoolId) &&
        incoming().nome is string && incoming().nome.size() <= 150 &&
        incoming().codInep is string && incoming().codInep.size() <= 50 &&
        incoming().cidade is string && incoming().cidade.size() <= 100 &&
        incoming().matriculas is number &&
        incoming().idebMedio is number &&
        incoming().metaIdeb is number &&
        incoming().status is string;
      // nome/codInep travados no update comum (revisão pós-PR #8, seção 3):
      // são a identidade CANÔNICA usada por school_years/turmas/snapshots/
      // imports (ver isCanonicalSchoolMatch acima) — uma edição comum não
      // pode alterá-los por baixo de todo o resto que depende deles, nem
      // mesmo o admin. Correção de nome/INEP real, quando necessária, é um
      // processo administrativo de migração controlada, fora desta regra.
      allow update: if isAuthorized() && isValidId(schoolId) &&
        canWriteEscola(resource.data.nome) &&
        incoming().nome == resource.data.nome &&
        incoming().codInep == resource.data.codInep &&
        incoming().cidade is string && incoming().cidade.size() <= 100 &&
        incoming().matriculas is number &&
        incoming().idebMedio is number &&
        incoming().metaIdeb is number &&
        incoming().status is string;
      // Dado histórico/cadastral — sem exclusão livre, só admin raiz.
      allow delete: if isPlatformAdmin() && isValidId(schoolId);
    }

    // --- Turmas (revisão pós-PR #8, correção final) ---
    // create/update/delete SEPARADOS de propósito — a versão anterior usava
    // a MESMA regra (canWriteEscola(incoming().escolaNome)) para create e
    // update, o que permitia: (a) criar uma turma com um schoolId real de
    // OUTRA escola desde que escolaNome fosse a própria (mesma lacuna já
    // fechada em school_years/enrollment_snapshots); (b) mover uma turma de
    // uma escola para outra por update, bastando reenviar escolaId/
    // escolaNome/schoolId novos.

    // Turma legada = documento anterior à Fase 2A, sem os campos novos
    // (schoolId/codInep/anoLetivo/createdAt/createdBy). Enriquecimento só é
    // aceito quando o valor introduzido é o CANÔNICO — nunca um valor
    // arbitrário que "mudaria" a turma de escola por baixo dos panos.
    function turmaSchoolIdRespected() {
      return resource.data.get('schoolId', null) != null
        ? incoming().get('schoolId', null) == resource.data.schoolId
        : (!('schoolId' in incoming()) || incoming().schoolId == resource.data.escolaId);
    }

    function turmaCodInepRespected() {
      return resource.data.get('codInep', null) != null
        ? incoming().get('codInep', null) == resource.data.codInep
        : (
            !('codInep' in incoming()) ||
            isCanonicalCodInepForSchool(incoming().get('schoolId', resource.data.escolaId), incoming().codInep)
          );
    }

    // anoLetivo/createdAt/createdBy: mesma lógica de "trava quando já
    // existe, senão pode ser preenchido pela primeira vez" — mas sem valor
    // canônico externo para comparar (diferente de schoolId/codInep).
    function turmaFieldRespectedOnceSet(fieldName) {
      return resource.data.get(fieldName, null) != null
        ? incoming().get(fieldName, null) == resource.data.get(fieldName, null)
        : true;
    }

    // Campos novos (Fase 2A) genuinamente opcionais da turma — quando
    // presentes no payload, precisam ter o tipo certo. Reutilizada por
    // create e update: no update, nem toda gravação toca estes campos
    // (ex.: Ativar/Inativar só envia `ativa`), então a validação é sempre
    // "se presente, válido" (último ajuste de integridade das turmas —
    // antes, só o create validava; um update malformado de ativa/
    // modalidade/cargaHoraria passava sem checagem nenhuma de tipo).
    function isValidTurmaOptionalFieldsIfPresent() {
      return
        (!('modalidade' in incoming()) || incoming().modalidade in ['Regular', 'Tempo Integral', 'Educação Profissional', 'EJA', 'Educação Especial', 'Outra']) &&
        (!('cargaHoraria' in incoming()) || isNonNegInt(incoming().cargaHoraria)) &&
        (!('ativa' in incoming()) || incoming().ativa is bool);
    }

    match /turmas/{turmaId} {
      allow read: if isAuthorized();

      // Ver seção 2.1 da revisão: acesso por schoolId (não por nome
      // solto), schoolId obrigatoriamente igual a escolaId nas turmas
      // novas, e schoolId/codInep/escolaNome precisam bater com o
      // documento real de `schools` — nunca só por nome.
      allow create: if isValidId(turmaId) &&
        canWriteSchoolById(incoming().schoolId) &&
        incoming().schoolId == incoming().escolaId &&
        isCanonicalSchoolMatch(incoming().schoolId, incoming().codInep, incoming().escolaNome) &&
        isValidAnoLetivo(incoming().anoLetivo) &&
        isNonNegInt(incoming().matriculaInicial) &&
        isNonNegInt(incoming().matriculaAtual) &&
        incoming().escolaId is string && incoming().escolaId.size() <= 128 &&
        incoming().escolaNome is string && incoming().escolaNome.size() <= 150 &&
        incoming().nome is string && incoming().nome.size() <= 100 &&
        incoming().ano is string && incoming().ano.size() <= 20 &&
        incoming().periodo is string && incoming().periodo.size() <= 50 &&
        incoming().alunosSinalizados is number &&
        isValidTurmaOptionalFieldsIfPresent() &&
        incoming().createdAt is string && incoming().createdBy is string &&
        incoming().updatedAt is string && incoming().updatedBy is string;

      // Autorização pelo dono ANTERIOR (resource.data.escolaNome) — nunca
      // pelo payload novo, senão um update vira uma forma de sequestrar a
      // turma de outra escola. id/escolaId/escolaNome nunca mudam;
      // schoolId/codInep/anoLetivo/createdAt/createdBy travam quando já
      // existem, mas uma turma legada pode ganhá-los pela primeira vez
      // (só com valor canônico — ver as funções acima).
      allow update: if isValidId(turmaId) &&
        canWriteEscola(resource.data.escolaNome) &&
        incoming().escolaId == resource.data.escolaId &&
        incoming().escolaNome == resource.data.escolaNome &&
        turmaSchoolIdRespected() &&
        turmaCodInepRespected() &&
        turmaFieldRespectedOnceSet('anoLetivo') &&
        turmaFieldRespectedOnceSet('createdAt') &&
        turmaFieldRespectedOnceSet('createdBy') &&
        incoming().nome is string && incoming().nome.size() <= 100 &&
        incoming().ano is string && incoming().ano.size() <= 20 &&
        incoming().periodo is string && incoming().periodo.size() <= 50 &&
        incoming().alunosSinalizados is number &&
        isValidTurmaOptionalFieldsIfPresent() &&
        (!('matriculaInicial' in incoming()) || isNonNegInt(incoming().matriculaInicial)) &&
        (!('matriculaAtual' in incoming()) || isNonNegInt(incoming().matriculaAtual)) &&
        incoming().updatedAt is string && incoming().updatedBy is string;

      // Superintendente comum NUNCA exclui turma — o fluxo normal é
      // ativa: false (Ativar/Inativar na interface, seção 7 do plano
      // anterior). Só o admin raiz, mesmo padrão de schools/school_years.
      allow delete: if isPlatformAdmin() && isValidId(turmaId);
    }

    // --- Grades (LEGADO — Fase 2C: substituída por student_rosters +
    // student_bimester_grades, ver docs/fase-2c-inventario-notas-legadas.md
    // e docs/plano-migracao-grades-legado.md) ---
    // grades nunca teve schoolId (Opção C da Fase 0 nunca foi migrada —
    // isAuthorized() sozinho não isolava por escola, qualquer
    // superintendente ativo lia/editava boletins de qualquer escola). A
    // Fase 2C não corrige isso com uma migração real (fora de escopo,
    // exigiria resolver ambiguidade de nome de turma entre escolas — ver
    // plano de migração); em vez disso, preserva os documentos existentes
    // e fecha a coleção: só o admin raiz lê (para eventual auditoria/
    // exportação manual), e create/update/delete ficam bloqueados para
    // TODOS pela aplicação, inclusive admin raiz — a nova interface
    // (NotasView.tsx) não lê grades, nem mesmo para o admin raiz. Reservada
    // só para uma futura migração controlada.
    match /grades/{gradeId} {
      allow read: if isPlatformAdmin();
      allow create, update, delete: if false;
    }

    // --- Visitas ---
    match /visitas/{visitaId} {
      allow read: if isAuthorized();
      allow create, update: if isAuthorized() && isValidId(visitaId) &&
        canWriteEscola(incoming().escola) &&
        incoming().escola is string && incoming().escola.size() <= 150 &&
        incoming().tecnico is string && incoming().tecnico.size() <= 150 &&
        incoming().data is string && incoming().data.size() <= 30 &&
        incoming().foco is string && incoming().foco.size() <= 200 &&
        incoming().status is string;
      allow delete: if isAuthorized() && isValidId(visitaId) &&
        canWriteEscola(resource.data.escola);
    }

    // Shape do documento, comum a create e update — a diferença entre os
    // dois (imutabilidade de id/schoolId/codInep/anoLetivo, autorização
    // sobre o dono ANTIGO do documento) fica só no match abaixo.
    function isValidSchoolYearShape(yearId) {
      return incoming().keys().hasOnly([
          'id', 'schoolId', 'codInep', 'escolaNome', 'anoLetivo',
          'matriculaInicial', 'matriculaAtual', 'quantidadeTurmasAtivas',
          'status', 'dataInicio', 'dataFim', 'ultimaAtualizacao',
          'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ]) &&
        incoming().id == yearId &&
        incoming().schoolId is string && incoming().schoolId.size() <= 128 &&
        incoming().codInep is string && incoming().codInep.size() <= 50 &&
        incoming().escolaNome is string && incoming().escolaNome.size() <= 150 &&
        isValidAnoLetivo(incoming().anoLetivo) &&
        // ID determinístico validado contra os campos internos (seção 5 do
        // plano: schoolId_anoLetivo) — impede um schoolId/anoLetivo no
        // payload que não bate com o próprio documentId.
        yearId == incoming().schoolId + '_' + string(incoming().anoLetivo) &&
        (incoming().matriculaInicial == null || isNonNegInt(incoming().matriculaInicial)) &&
        (incoming().matriculaAtual == null || isNonNegInt(incoming().matriculaAtual)) &&
        isNonNegInt(incoming().quantidadeTurmasAtivas) &&
        incoming().status in ['planejamento', 'ativo', 'encerrado', 'arquivado'] &&
        (incoming().dataInicio == null || (incoming().dataInicio is string && incoming().dataInicio.size() <= 30)) &&
        (!('dataFim' in incoming()) || incoming().dataFim == null || (incoming().dataFim is string && incoming().dataFim.size() <= 30)) &&
        incoming().ultimaAtualizacao is string &&
        incoming().createdAt is string && incoming().updatedAt is string &&
        incoming().createdBy is string && incoming().updatedBy is string;
    }

    // --- Fase 2A: school_years ---
    // Estrutura anual da escola. Os dados pertencem à escola+anoLetivo, não
    // ao superintendente (ver seção "Regra principal" do plano) — troca de
    // responsável não afeta estes documentos, só o vínculo em
    // superintendentes/{email}.escolas.
    match /school_years/{yearId} {
      // Baseado em schoolId (canWriteSchoolById), não em escolaNome: os
      // serviços desta fase sempre consultam school_years filtrando por
      // schoolId (ver SchoolYearService), e o Firestore só consegue provar
      // a segurança de uma consulta (list) quando a regra depende do MESMO
      // campo usado no where() da consulta — uma regra baseada em
      // escolaNome nunca seria aprovada para uma consulta filtrada por
      // schoolId, mesmo quando o dado real bateria. .get(..., '') evita
      // erro de avaliação contra o documento hipotético sem o campo.
      allow read: if canWriteSchoolById(resource.data.get('schoolId', ''));

      // isCanonicalSchoolMatch (revisão pós-PR #8) fecha a lacuna de
      // canWriteEscola(incoming().escolaNome) sozinho: prova não só que o
      // usuário PODE escrever numa escola com esse nome, mas que
      // schoolId/codInep/escolaNome do payload realmente descrevem a MESMA
      // escola em `schools` — sem isso, a Escola A podia criar um
      // school_year com o schoolId real da Escola B só preenchendo
      // escolaNome com o próprio nome (que ela tem permissão de escrever).
      // isAuthorized() sai daqui de propósito (mesmo motivo do update
      // logo abaixo): canWriteEscola() já implica isAuthorized(), e cada
      // chamada extra a isAdmin()/isActiveSuperintendent() pesa no limite
      // de 1000 sub-expressões do emulador local.
      allow create: if isValidId(yearId) &&
        canWriteEscola(incoming().escolaNome) &&
        isCanonicalSchoolMatch(incoming().schoolId, incoming().codInep, incoming().escolaNome) &&
        isValidSchoolYearShape(yearId);

      // create/update SEPARADOS de propósito (ver revisão pré-PR): a versão
      // anterior usava canWriteEscola(incoming().escolaNome) para os dois,
      // o que autorizava um update olhando só para o payload NOVO — um
      // superintendente da Escola B podia sequestrar o documento existente
      // da Escola A bastando enviar escolaNome/schoolId da própria Escola B
      // no update. Agora update exige acesso à escola JÁ DONA do documento
      // (resource.data.escolaNome — um único canWriteEscola(), não dois: o
      // emulador local estoura o limite de expressões ao avaliar isAdmin()
      // repetidas vezes na mesma regra) e trava id/schoolId/codInep/
      // anoLetivo/escolaNome como imutáveis — o ano letivo de um registro
      // nunca muda para "virar" outro registro, e isAuthorized() sai daqui
      // de propósito porque canWriteEscola() já implica isAuthorized().
      // createdAt/createdBy também travados (revisão pós-PR #8): sem isso,
      // um update podia reescrever a autoria/data de criação originais.
      allow update: if isValidId(yearId) &&
        canWriteEscola(resource.data.escolaNome) &&
        incoming().schoolId == resource.data.schoolId &&
        incoming().codInep == resource.data.codInep &&
        incoming().anoLetivo == resource.data.anoLetivo &&
        incoming().escolaNome == resource.data.escolaNome &&
        incoming().createdAt == resource.data.createdAt &&
        incoming().createdBy == resource.data.createdBy &&
        isValidSchoolYearShape(yearId);

      // Sem exclusão livre — igual a `schools`, o histórico anual só é
      // arquivado (status: 'arquivado'), nunca apagado por um usuário comum.
      allow delete: if isPlatformAdmin() && isValidId(yearId);
    }

    // Shape do documento, comum a create e update — mesma separação de
    // responsabilidade de isValidSchoolYearShape() acima.
    function isValidEnrollmentSnapshotShape(snapshotId) {
      return incoming().keys().hasOnly([
          'id', 'schoolId', 'codInep', 'escolaNome', 'turmaId', 'turmaNome',
          'anoLetivo', 'mesReferencia', 'matriculaInicioMes', 'novasMatriculas',
          'transferenciasEntrada', 'transferenciasSaida', 'abandono', 'outrasSaidas',
          'matriculaFimMes', 'observacao', 'reviewStatus',
          'sourceSystem', 'sourceReportType', 'sourceReportTitle', 'sourceFileName',
          'sourceGeneratedAt', 'sourceFileHash', 'importBatchId',
          'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ]) &&
        incoming().id == snapshotId &&
        incoming().schoolId is string && incoming().schoolId.size() <= 128 &&
        incoming().codInep is string && incoming().codInep.size() <= 50 &&
        incoming().escolaNome is string && incoming().escolaNome.size() <= 150 &&
        incoming().turmaId is string && incoming().turmaId.size() <= 128 &&
        incoming().turmaNome is string && incoming().turmaNome.size() <= 150 &&
        isValidAnoLetivo(incoming().anoLetivo) &&
        isValidMesReferencia(incoming().mesReferencia) &&
        isMesReferenciaWithinAnoLetivo(incoming().mesReferencia, incoming().anoLetivo) &&
        // ID determinístico validado contra os campos internos (seção 7 do
        // plano: schoolId_turmaId_mesReferencia).
        snapshotId == incoming().schoolId + '_' + incoming().turmaId + '_' + incoming().mesReferencia &&
        isNonNegInt(incoming().matriculaInicioMes) &&
        isNonNegInt(incoming().novasMatriculas) &&
        isNonNegInt(incoming().transferenciasEntrada) &&
        isNonNegInt(incoming().transferenciasSaida) &&
        isNonNegInt(incoming().abandono) &&
        isNonNegInt(incoming().outrasSaidas) &&
        isNonNegInt(incoming().matriculaFimMes) &&
        incoming().reviewStatus in ['manual', 'importado_pendente', 'confirmado', 'divergencia', 'corrigido'] &&
        incoming().createdAt is string && incoming().updatedAt is string &&
        incoming().createdBy is string && incoming().updatedBy is string;
    }

    // --- Fase 2A: enrollment_snapshots ---
    // Matrícula mensal por turma. Imutável por mês: o ID determinístico
    // (schoolId_turmaId_YYYY-MM) garante que corrigir um mês nunca sobrescreve
    // outro. Exclusão comum bloqueada (seção "Histórico" do plano).
    match /enrollment_snapshots/{snapshotId} {
      // Ver comentário equivalente em school_years — baseado em schoolId
      // (o campo que EnrollmentSnapshotService realmente usa no where() de
      // listEnrollmentSnapshotsForSchool), não em escolaNome.
      allow read: if canWriteSchoolById(resource.data.get('schoolId', ''));

      // isCanonicalSchoolMatch/isCanonicalTurmaOfSchool (revisão pós-PR #8):
      // mesma lacuna de school_years, mais a integridade da turma —
      // canWriteEscola(incoming().escolaNome) sozinho não provava que
      // turmaId pertence à MESMA escola do snapshot, nem que schoolId
      // aponta para a escola que escolaNome diz ser. isAuthorized() sai
      // daqui de propósito (mesmo motivo de school_years — canWriteEscola()
      // já implica isAuthorized(), e o emulador local tem um limite de 1000
      // sub-expressões por avaliação de regra).
      allow create: if isValidId(snapshotId) &&
        canWriteEscola(incoming().escolaNome) &&
        isCanonicalSchoolMatch(incoming().schoolId, incoming().codInep, incoming().escolaNome) &&
        isCanonicalTurmaOfSchool(incoming().turmaId, incoming().schoolId) &&
        isValidEnrollmentSnapshotShape(snapshotId);

      // Update = correção do MESMO mês/turma/escola (ver seção "Histórico"
      // do plano) — nunca uma forma de mudar de escola/turma/mês mantendo o
      // ID. Mesma correção de segurança/desempenho de school_years: um só
      // canWriteEscola() sobre o dono ANTIGO do documento (não dois — ver
      // comentário em school_years sobre o limite de expressões do
      // emulador), schoolId/turmaId/anoLetivo/mesReferencia/escolaNome
      // travados como imutáveis, isAuthorized() removido por já estar
      // implícito em canWriteEscola(). createdAt/createdBy também travados
      // (revisão pós-PR #8), mesmo motivo de school_years.
      allow update: if isValidId(snapshotId) &&
        canWriteEscola(resource.data.escolaNome) &&
        incoming().schoolId == resource.data.schoolId &&
        incoming().turmaId == resource.data.turmaId &&
        incoming().anoLetivo == resource.data.anoLetivo &&
        incoming().escolaNome == resource.data.escolaNome &&
        incoming().mesReferencia == resource.data.mesReferencia &&
        incoming().createdAt == resource.data.createdAt &&
        incoming().createdBy == resource.data.createdBy &&
        isValidEnrollmentSnapshotShape(snapshotId);

      allow delete: if isPlatformAdmin() && isValidId(snapshotId);
    }

    // Shape do documento, comum a create e update — mesma separação de
    // responsabilidade de isValidSchoolYearShape()/isValidEnrollmentSnapshotShape()
    // acima. Percentuais nunca fazem parte do schema (seção 3 do plano —
    // são sempre calculados na aplicação a partir de aprovados/reprovados/
    // abandono, nunca persistidos).
    function isValidSchoolFlowResultShape(resultId) {
      return incoming().keys().hasOnly([
          'id', 'schoolId', 'codInep', 'escolaNome', 'anoLetivo',
          'aprovados', 'reprovados', 'abandono', 'status', 'observacao',
          'sourceSystem', 'sourceReportTitle', 'sourceFileName', 'sourceFileHash', 'importBatchId',
          'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ]) &&
        incoming().id == resultId &&
        incoming().schoolId is string && incoming().schoolId.size() <= 128 &&
        incoming().codInep is string && incoming().codInep.size() <= 50 &&
        incoming().escolaNome is string && incoming().escolaNome.size() <= 150 &&
        isValidAnoLetivo(incoming().anoLetivo) &&
        // ID determinístico validado contra os campos internos (seção 3 do
        // plano: schoolId_anoLetivo) — mesmo princípio de school_years.
        resultId == incoming().schoolId + '_' + string(incoming().anoLetivo) &&
        isNonNegInt(incoming().aprovados) &&
        isNonNegInt(incoming().reprovados) &&
        isNonNegInt(incoming().abandono) &&
        incoming().status in ['rascunho', 'confirmado'] &&
        // Confirmado exige total > 0; rascunho pode ter total zero (seção 5
        // do plano) — nunca inventa quantitativo ausente.
        (incoming().status == 'rascunho' ||
          (incoming().aprovados + incoming().reprovados + incoming().abandono) > 0) &&
        (!('observacao' in incoming()) || (incoming().observacao is string && incoming().observacao.size() <= 500)) &&
        (!('sourceSystem' in incoming()) || incoming().sourceSystem in ['Manual', 'SIGE Escola', 'Importação administrativa']) &&
        (!('sourceReportTitle' in incoming()) || (incoming().sourceReportTitle is string && incoming().sourceReportTitle.size() <= 200)) &&
        (!('sourceFileName' in incoming()) || (incoming().sourceFileName is string && incoming().sourceFileName.size() <= 200)) &&
        (!('sourceFileHash' in incoming()) || (incoming().sourceFileHash is string && incoming().sourceFileHash.size() <= 200)) &&
        (!('importBatchId' in incoming()) || (incoming().importBatchId is string && incoming().importBatchId.size() <= 200)) &&
        incoming().createdAt is string && incoming().updatedAt is string &&
        incoming().createdBy is string && incoming().updatedBy is string;
    }

    // --- Fase 2B: school_flow_results ---
    // Resultado anual agregado de fluxo escolar (aprovados/reprovados/
    // abandono) por escola+ano letivo. Só dados agregados — nunca nome ou
    // identificador de estudante (ver types/schoolFlow.ts). Mesmo modelo de
    // autorização e mesma proteção de integridade canônica de school_years
    // (não há turma envolvida aqui, então não precisa de
    // isCanonicalTurmaOfSchool).
    match /school_flow_results/{resultId} {
      // Baseado em schoolId (canWriteSchoolById), não em escolaNome — mesmo
      // motivo de school_years/enrollment_snapshots: SchoolFlowService
      // sempre consulta por schoolId (ver getSchoolFlowResult), e o
      // Firestore só consegue provar a segurança de uma consulta (list)
      // quando a regra depende do MESMO campo usado no where().
      allow read: if canWriteSchoolById(resource.data.get('schoolId', ''));

      // isCanonicalSchoolMatch (mesmo princípio de school_years/
      // enrollment_snapshots): prova que schoolId/codInep/escolaNome do
      // payload realmente descrevem a MESMA escola em `schools` — sem isso,
      // a Escola A podia criar um resultado com o schoolId real da Escola B
      // só preenchendo escolaNome com o próprio nome (que ela tem permissão
      // de escrever). isAuthorized() sai daqui de propósito: canWriteEscola()
      // já implica isAuthorized().
      allow create: if isValidId(resultId) &&
        canWriteEscola(incoming().escolaNome) &&
        isCanonicalSchoolMatch(incoming().schoolId, incoming().codInep, incoming().escolaNome) &&
        isValidSchoolFlowResultShape(resultId);

      // Update = correção do MESMO ano/escola (nunca uma forma de mudar de
      // escola/ano mantendo o ID) — mesma estrutura de school_years: um só
      // canWriteEscola() sobre o dono ANTIGO do documento, id/schoolId/
      // codInep/escolaNome/anoLetivo travados como imutáveis, createdAt/
      // createdBy também travados, isAuthorized() removido por já estar
      // implícito em canWriteEscola().
      allow update: if isValidId(resultId) &&
        canWriteEscola(resource.data.escolaNome) &&
        incoming().schoolId == resource.data.schoolId &&
        incoming().codInep == resource.data.codInep &&
        incoming().anoLetivo == resource.data.anoLetivo &&
        incoming().escolaNome == resource.data.escolaNome &&
        incoming().createdAt == resource.data.createdAt &&
        incoming().createdBy == resource.data.createdBy &&
        isValidSchoolFlowResultShape(resultId);

      // Sem exclusão livre — mesmo padrão de school_years/enrollment_snapshots,
      // só o admin raiz exclui.
      allow delete: if isPlatformAdmin() && isValidId(resultId);
    }

    // --- Fase 2C.1: student_rosters (PROTÓTIPO NOMINAL DESCONTINUADO) ---
    // A Fase 2C original modelou "Notas Bimestrais" como um cadastro nominal
    // de estudantes por turma — escopo errado: o SIFEC não é o SIGE Escola,
    // não deve manter relação nominal de estudantes (ver
    // docs/descontinuacao-prototipo-notas-nominais.md). A Fase 2C.1
    // substitui esse protótipo por grade_entry_monitoring (agregado por
    // turma, nunca nominal) e fecha esta coleção — mesmo padrão já aplicado
    // à coleção `grades` (legado anterior): só o admin raiz lê, para fins de
    // auditoria; create/update/delete bloqueados para TODOS, inclusive
    // admin raiz. Nenhum documento existente é excluído ou migrado por esta
    // regra — só impede novas leituras/escritas pela aplicação.
    match /student_rosters/{rosterId} {
      allow read: if isPlatformAdmin();
      allow create, update, delete: if false;
    }

    // --- Fase 2C.1: student_bimester_grades (PROTÓTIPO NOMINAL DESCONTINUADO) ---
    // Mesma correção de escopo de student_rosters acima — nota bimestral
    // POR ESTUDANTE não é o objetivo do SIFEC (ver
    // docs/descontinuacao-prototipo-notas-nominais.md). Fechada com o mesmo
    // padrão: só admin raiz lê (auditoria), create/update/delete bloqueados
    // para todos. Nenhum documento existente é excluído ou migrado.
    match /student_bimester_grades/{gradeId} {
      allow read: if isPlatformAdmin();
      allow create, update, delete: if false;
    }

    // Shape do documento, comum a create e update — mesmo padrão de
    // isValidSchoolFlowResultShape/isValidStudentRosterShape (Fase 2C.1).
    // Nunca inclui nome/matrícula/CPF de estudante nem nota individual — só
    // totais agregados por turma (ver src/types/gradeEntryMonitoring.ts).
    // `let data = incoming()` uma única vez pelo mesmo motivo de orçamento
    // de sub-expressões do emulador local documentado nas coleções acima.
    function isValidGradeEntryMonitoringShape(monitoringId) {
      let data = incoming();
      return data.keys().hasOnly([
          'id', 'schoolId', 'codInep', 'escolaNome', 'turmaId', 'turmaNome',
          'anoLetivo', 'bimestre', 'totalStudents', 'studentsWithCompleteGrades',
          'studentsWithPartialGrades', 'studentsWithoutGrades',
          'expectedGradeEntries', 'completedGradeEntries', 'status',
          'sourceSystem', 'sourceReportTitle', 'sourceFileName', 'sourceFileHash',
          'referenceDate', 'observation',
          'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ]) &&
        data.id == monitoringId &&
        data.schoolId is string && data.schoolId.size() <= 128 &&
        data.codInep is string && data.codInep.size() <= 50 &&
        data.escolaNome is string && data.escolaNome.size() <= 150 &&
        data.turmaId is string && data.turmaId.size() <= 128 &&
        data.turmaNome is string && data.turmaNome.size() <= 150 &&
        isValidAnoLetivo(data.anoLetivo) &&
        data.bimestre in [1, 2, 3, 4] &&
        // ID determinístico validado contra os campos internos (seção 5 do
        // plano da Fase 2C.1: schoolId_anoLetivo_bBimestre_turmaId).
        monitoringId == data.schoolId + '_' + string(data.anoLetivo) + '_b' + string(data.bimestre) + '_' + data.turmaId &&
        isNonNegInt(data.totalStudents) &&
        isNonNegInt(data.studentsWithCompleteGrades) &&
        isNonNegInt(data.studentsWithPartialGrades) &&
        isNonNegInt(data.studentsWithoutGrades) &&
        isNonNegInt(data.expectedGradeEntries) &&
        isNonNegInt(data.completedGradeEntries) &&
        data.completedGradeEntries <= data.expectedGradeEntries &&
        (data.studentsWithCompleteGrades + data.studentsWithPartialGrades + data.studentsWithoutGrades) == data.totalStudents &&
        data.status in ['rascunho', 'confirmado'] &&
        data.sourceSystem == 'SIGE Escola' &&
        data.referenceDate is string &&
        data.referenceDate.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$') &&
        (!('sourceReportTitle' in data) || (data.sourceReportTitle is string && data.sourceReportTitle.size() <= 200)) &&
        (!('sourceFileName' in data) || (data.sourceFileName is string && data.sourceFileName.size() <= 200)) &&
        (!('sourceFileHash' in data) || (data.sourceFileHash is string && data.sourceFileHash.size() <= 200)) &&
        (!('observation' in data) || (data.observation is string && data.observation.size() <= 500)) &&
        data.createdAt is string && data.updatedAt is string &&
        data.createdBy is string && data.updatedBy is string;
    }

    // --- Fase 2C.1: grade_entry_monitoring ---
    // Acompanhamento AGREGADO, por escola+turma+ano letivo+bimestre, do
    // preenchimento de notas que a escola já faz no SIGE Escola — nunca por
    // estudante (substitui student_rosters/student_bimester_grades acima).
    // Mesmo modelo de autorização e integridade canônica de
    // school_flow_results, mais isCanonicalTurmaOfSchoolYear (a turma
    // precisa existir, pertencer à MESMA escola, e ser do MESMO ano letivo
    // — mesmo helper já usado por student_rosters antes desta correção).
    match /grade_entry_monitoring/{monitoringId} {
      // Baseado em schoolId (canWriteSchoolById) — GradeEntryMonitoringService
      // sempre consulta por schoolId (nunca a coleção completa), e o
      // Firestore só prova a segurança de uma consulta quando a regra
      // depende do MESMO campo usado no where().
      allow read: if canWriteSchoolById(resource.data.get('schoolId', ''));

      // isCanonicalTurmaOfSchoolYearAndName (não a variante sem nome): a
      // revisão do code review do PR #17, seção 3, exige que turmaNome
      // corresponda EXATAMENTE ao nome real cadastrado em `turmas`, não só
      // schoolId/anoLetivo — ver comentário do helper.
      allow create: if isValidId(monitoringId) &&
        canWriteEscola(incoming().escolaNome) &&
        isCanonicalSchoolMatch(incoming().schoolId, incoming().codInep, incoming().escolaNome) &&
        isCanonicalTurmaOfSchoolYearAndName(incoming().turmaId, incoming().schoolId, incoming().anoLetivo, incoming().turmaNome) &&
        isValidGradeEntryMonitoringShape(monitoringId);

      // Update = correção do MESMO acompanhamento (mesma escola/turma/ano/
      // bimestre) — nunca uma forma de mudar de turma/ano/bimestre mantendo
      // o ID. id/schoolId/codInep/escolaNome/turmaId/turmaNome/anoLetivo/
      // bimestre/createdAt/createdBy travados como imutáveis — mesmo padrão
      // de school_years/school_flow_results (comparação par-a-par em vez de
      // diff().affectedKeys(): esta coleção não tem um subconjunto pequeno
      // e fixo de campos alteráveis como student_rosters tinha só
      // studentName/active — quase todo campo pode mudar numa correção do
      // relatório, então travar só os campos de identidade é mais direto).
      // turmaNome incluído na revisão do code review do PR #17, seção 3: o
      // nome exibido da turma faz parte da identidade do acompanhamento
      // tanto quanto turmaId — sem esta trava, uma correção podia renomear
      // silenciosamente a turma de um relatório já registrado sem tocar
      // turmaId, divergindo do nome real cadastrado em `turmas`.
      allow update: if isValidId(monitoringId) &&
        canWriteEscola(resource.data.escolaNome) &&
        incoming().schoolId == resource.data.schoolId &&
        incoming().codInep == resource.data.codInep &&
        incoming().escolaNome == resource.data.escolaNome &&
        incoming().turmaId == resource.data.turmaId &&
        incoming().turmaNome == resource.data.turmaNome &&
        incoming().anoLetivo == resource.data.anoLetivo &&
        incoming().bimestre == resource.data.bimestre &&
        incoming().createdAt == resource.data.createdAt &&
        incoming().createdBy == resource.data.createdBy &&
        isValidGradeEntryMonitoringShape(monitoringId);

      // Sem exclusão comum — mesmo padrão de school_years/school_flow_results,
      // só o admin raiz exclui, em manutenção excepcional.
      allow delete: if isPlatformAdmin() && isValidId(monitoringId);
    }

    // ============================================================================
    // REESTRUTURAÇÃO SIFEC — seis coleções novas, mesmo modelo de autorização e
    // integridade canônica de grade_entry_monitoring/school_years acima
    // (canWriteEscola/canWriteSchoolById + isCanonicalSchoolMatch + hasOnly()).
    // bimonthly_enrollments, cdg_planos e parecer_bimestral_notas usam ID
    // determinístico por chave composta (mesmo princípio de
    // buildGradeEntryMonitoringId); farol_estudante, recomposicao_planos e
    // cdg_tarefas usam ID opaco (crypto.randomUUID() no cliente — nunca
    // derivado de nome de estudante ou texto livre, mesmo cuidado de
    // buildStudentRosterId). Exclusão comum (não só admin) é permitida em
    // farol_estudante/recomposicao_planos/cdg_tarefas — são listas de
    // trabalho da própria escola, não histórico auditável imutável como
    // grade_entry_monitoring; bimonthly_enrollments/cdg_planos/
    // parecer_bimestral_notas seguem restritos ao admin raiz na exclusão,
    // mesmo padrão de school_years/school_flow_results.
    // ============================================================================

    // --- Reestruturação SIFEC: bimonthly_enrollments ---
    // Matrícula por escola+bimestre (substitui o registro mensal por turma
    // no fluxo de Gestão de Escolas — enrollment_snapshots continua existindo
    // só para leitura da Sala de Situação, nunca mais gravado pela UI).
    function isValidBimonthlyEnrollmentShape(enrollmentId) {
      let data = incoming();
      return data.keys().hasOnly([
          'id', 'schoolId', 'codInep', 'escolaNome', 'anoLetivo', 'bimestre',
          'matricula', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ]) &&
        data.id == enrollmentId &&
        data.schoolId is string && data.schoolId.size() <= 128 &&
        data.codInep is string && data.codInep.size() <= 50 &&
        data.escolaNome is string && data.escolaNome.size() <= 150 &&
        isValidAnoLetivo(data.anoLetivo) &&
        data.bimestre in [1, 2, 3, 4] &&
        enrollmentId == data.schoolId + '_' + string(data.anoLetivo) + '_b' + string(data.bimestre) &&
        isNonNegInt(data.matricula) &&
        data.createdAt is string && data.updatedAt is string &&
        data.createdBy is string && data.updatedBy is string;
    }

    match /bimonthly_enrollments/{enrollmentId} {
      allow read: if canWriteSchoolById(resource.data.get('schoolId', ''));
      allow create: if isValidId(enrollmentId) &&
        canWriteEscola(incoming().escolaNome) &&
        isCanonicalSchoolMatch(incoming().schoolId, incoming().codInep, incoming().escolaNome) &&
        isValidBimonthlyEnrollmentShape(enrollmentId);
      allow update: if isValidId(enrollmentId) &&
        canWriteEscola(resource.data.escolaNome) &&
        incoming().schoolId == resource.data.schoolId &&
        incoming().codInep == resource.data.codInep &&
        incoming().escolaNome == resource.data.escolaNome &&
        incoming().anoLetivo == resource.data.anoLetivo &&
        incoming().bimestre == resource.data.bimestre &&
        incoming().createdAt == resource.data.createdAt &&
        incoming().createdBy == resource.data.createdBy &&
        isValidBimonthlyEnrollmentShape(enrollmentId);
      allow delete: if isPlatformAdmin() && isValidId(enrollmentId);
    }

    // --- Reestruturação SIFEC: farol_estudante ---
    // "Alunos com Baixo Desempenho (Farol do Estudante)" — lista NOMINAL
    // (estudanteNome) de estudantes com percentual de acerto < 25% no SISEDU
    // Analytics, lançada manualmente. Dado sensível: leitura restrita à
    // mesma escola do superintendente (ou admin), nunca mais amplo.
    // isCanonicalTurmaOfSchoolYearAndName garante que a turma referenciada
    // existe de fato e pertence à mesma escola/ano — mesmo princípio de
    // grade_entry_monitoring.
    function isValidFarolEstudanteShape(itemId) {
      let data = incoming();
      return data.keys().hasOnly([
          'id', 'schoolId', 'codInep', 'escolaNome', 'turmaId', 'turmaNome',
          'disciplina', 'anoLetivo', 'bimestre', 'estudanteNome', 'percentualAcerto',
          'sourceSystem', 'referenceDate', 'status', 'statusRegistro',
          'observacao', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ]) &&
        data.id == itemId &&
        data.schoolId is string && data.schoolId.size() <= 128 &&
        data.codInep is string && data.codInep.size() <= 50 &&
        data.escolaNome is string && data.escolaNome.size() <= 150 &&
        data.turmaId is string && data.turmaId.size() <= 128 &&
        data.turmaNome is string && data.turmaNome.size() <= 150 &&
        data.disciplina is string && data.disciplina.size() > 0 && data.disciplina.size() <= 100 &&
        isValidAnoLetivo(data.anoLetivo) &&
        data.bimestre in [1, 2, 3, 4] &&
        data.estudanteNome is string && data.estudanteNome.size() > 0 && data.estudanteNome.size() <= 150 &&
        data.percentualAcerto is int && data.percentualAcerto >= 0 && data.percentualAcerto < 25 &&
        // Fonte sempre fixa 'SISEDU Analytics' — nunca outra origem (nunca
        // afirma sincronização automática, ver farolEstudante.ts).
        data.sourceSystem == 'SISEDU Analytics' &&
        data.referenceDate is string && data.referenceDate.size() == 10 &&
        data.status in ['Identificado', 'Em acompanhamento', 'Superado'] &&
        // Correção final da auditoria, seção 2: statusRegistro é o campo de
        // arquivamento (nunca reaproveita `status`, que é o status de
        // acompanhamento pedagógico do estudante — semânticas diferentes).
        data.statusRegistro in ['ativo', 'arquivado'] &&
        (!('observacao' in data) || (data.observacao is string && data.observacao.size() <= 500)) &&
        data.createdAt is string && data.updatedAt is string &&
        data.createdBy is string && data.updatedBy is string;
    }

    match /farol_estudante/{itemId} {
      allow read: if canWriteSchoolById(resource.data.get('schoolId', ''));
      allow create: if isValidId(itemId) &&
        canWriteEscola(incoming().escolaNome) &&
        isCanonicalSchoolMatch(incoming().schoolId, incoming().codInep, incoming().escolaNome) &&
        isCanonicalTurmaOfSchoolYearAndName(incoming().turmaId, incoming().schoolId, incoming().anoLetivo, incoming().turmaNome) &&
        isValidFarolEstudanteShape(itemId);
      // update cobre tanto edição normal quanto arquivamento (statusRegistro
      // 'ativo' -> 'arquivado') — o superintendente da escola nunca precisa
      // de `delete` para "remover" um registro da lista de trabalho.
      allow update: if isValidId(itemId) &&
        canWriteEscola(resource.data.escolaNome) &&
        incoming().schoolId == resource.data.schoolId &&
        incoming().codInep == resource.data.codInep &&
        incoming().escolaNome == resource.data.escolaNome &&
        incoming().turmaId == resource.data.turmaId &&
        incoming().anoLetivo == resource.data.anoLetivo &&
        incoming().bimestre == resource.data.bimestre &&
        incoming().createdAt == resource.data.createdAt &&
        incoming().createdBy == resource.data.createdBy &&
        isValidFarolEstudanteShape(itemId);
      // Correção final da auditoria, seção 2: exclusão física NUNCA é
      // permitida para o superintendente comum (nem o da própria escola) —
      // "exclusão bloqueada para usuário comum" era o requisito não
      // atendido pela versão anterior desta regra (que usava
      // canWriteEscola()). Só o admin raiz pode excluir fisicamente, em
      // manutenção excepcional (ex.: registro de teste/erro grave de
      // digitação) — o caminho normal para a escola é arquivar (update).
      allow delete: if isPlatformAdmin() && isValidId(itemId);
    }

    // --- Reestruturação SIFEC: recomposicao_planos ---
    // Formulário livre do plano de recomposição da própria escola (prazo,
    // área/disciplina, turno, descrição) — substitui o protótipo anterior
    // com progresso numérico e planos padrão gerados automaticamente.
    function isValidRecomposicaoPlanShape(planId) {
      let data = incoming();
      return data.keys().hasOnly([
          'id', 'schoolId', 'codInep', 'escolaNome', 'anoLetivo', 'bimestre',
          'prazo', 'areaDisciplina', 'turno', 'descricao',
          'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ]) &&
        data.id == planId &&
        data.schoolId is string && data.schoolId.size() <= 128 &&
        data.codInep is string && data.codInep.size() <= 50 &&
        data.escolaNome is string && data.escolaNome.size() <= 150 &&
        isValidAnoLetivo(data.anoLetivo) &&
        data.bimestre in [1, 2, 3, 4] &&
        data.prazo is string && data.prazo.size() > 0 && data.prazo.size() <= 200 &&
        data.areaDisciplina is string && data.areaDisciplina.size() > 0 && data.areaDisciplina.size() <= 200 &&
        data.turno in ['Matutino', 'Vespertino', 'Noturno', 'Integral'] &&
        data.descricao is string && data.descricao.size() > 0 && data.descricao.size() <= 2000 &&
        data.createdAt is string && data.updatedAt is string &&
        data.createdBy is string && data.updatedBy is string;
    }

    match /recomposicao_planos/{planId} {
      allow read: if canWriteSchoolById(resource.data.get('schoolId', ''));
      allow create: if isValidId(planId) &&
        canWriteEscola(incoming().escolaNome) &&
        isCanonicalSchoolMatch(incoming().schoolId, incoming().codInep, incoming().escolaNome) &&
        isValidRecomposicaoPlanShape(planId);
      allow update: if isValidId(planId) &&
        canWriteEscola(resource.data.escolaNome) &&
        incoming().schoolId == resource.data.schoolId &&
        incoming().codInep == resource.data.codInep &&
        incoming().escolaNome == resource.data.escolaNome &&
        incoming().anoLetivo == resource.data.anoLetivo &&
        incoming().bimestre == resource.data.bimestre &&
        incoming().createdAt == resource.data.createdAt &&
        incoming().createdBy == resource.data.createdBy &&
        isValidRecomposicaoPlanShape(planId);
      allow delete: if canWriteEscola(resource.data.escolaNome) && isValidId(planId);
    }

    // --- Reestruturação SIFEC: cdg_planos ---
    // Ciclo de Gestão simplificado — um plano por escola+ano letivo:
    // situação (Ativo/Inativo) + status de execução.
    function isValidCdgPlanShape(planId) {
      let data = incoming();
      return data.keys().hasOnly([
          'id', 'schoolId', 'codInep', 'escolaNome', 'anoLetivo',
          'situacao', 'statusExecucao', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ]) &&
        data.id == planId &&
        data.schoolId is string && data.schoolId.size() <= 128 &&
        data.codInep is string && data.codInep.size() <= 50 &&
        data.escolaNome is string && data.escolaNome.size() <= 150 &&
        isValidAnoLetivo(data.anoLetivo) &&
        planId == data.schoolId + '_' + string(data.anoLetivo) &&
        data.situacao in ['Ativo', 'Inativo'] &&
        data.statusExecucao in ['Não iniciado', 'Em execução', 'Concluído'] &&
        data.createdAt is string && data.updatedAt is string &&
        data.createdBy is string && data.updatedBy is string;
    }

    match /cdg_planos/{planId} {
      allow read: if canWriteSchoolById(resource.data.get('schoolId', ''));
      allow create: if isValidId(planId) &&
        canWriteEscola(incoming().escolaNome) &&
        isCanonicalSchoolMatch(incoming().schoolId, incoming().codInep, incoming().escolaNome) &&
        isValidCdgPlanShape(planId);
      allow update: if isValidId(planId) &&
        canWriteEscola(resource.data.escolaNome) &&
        incoming().schoolId == resource.data.schoolId &&
        incoming().codInep == resource.data.codInep &&
        incoming().escolaNome == resource.data.escolaNome &&
        incoming().anoLetivo == resource.data.anoLetivo &&
        incoming().createdAt == resource.data.createdAt &&
        incoming().createdBy == resource.data.createdBy &&
        isValidCdgPlanShape(planId);
      allow delete: if isPlatformAdmin() && isValidId(planId);
    }

    // --- Reestruturação SIFEC: cdg_tarefas ---
    // Ações/tarefas do plano de Ciclo de Gestão — cada uma com seu próprio
    // status (inclui "Concluído com Atraso"/"Atrasado", pedidos pelo plano).
    function isValidCdgTaskShape(taskId) {
      let data = incoming();
      return data.keys().hasOnly([
          'id', 'schoolId', 'codInep', 'escolaNome', 'anoLetivo',
          'acao', 'responsavel', 'prazo', 'status',
          'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ]) &&
        data.id == taskId &&
        data.schoolId is string && data.schoolId.size() <= 128 &&
        data.codInep is string && data.codInep.size() <= 50 &&
        data.escolaNome is string && data.escolaNome.size() <= 150 &&
        isValidAnoLetivo(data.anoLetivo) &&
        data.acao is string && data.acao.size() > 0 && data.acao.size() <= 300 &&
        data.responsavel is string && data.responsavel.size() > 0 && data.responsavel.size() <= 150 &&
        data.prazo is string && data.prazo.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$') &&
        data.status in ['Não Iniciado', 'Previsto', 'Em Andamento', 'Concluído', 'Concluído com Atraso', 'Atrasado'] &&
        data.createdAt is string && data.updatedAt is string &&
        data.createdBy is string && data.updatedBy is string;
    }

    match /cdg_tarefas/{taskId} {
      allow read: if canWriteSchoolById(resource.data.get('schoolId', ''));
      allow create: if isValidId(taskId) &&
        canWriteEscola(incoming().escolaNome) &&
        isCanonicalSchoolMatch(incoming().schoolId, incoming().codInep, incoming().escolaNome) &&
        isValidCdgTaskShape(taskId);
      allow update: if isValidId(taskId) &&
        canWriteEscola(resource.data.escolaNome) &&
        incoming().schoolId == resource.data.schoolId &&
        incoming().codInep == resource.data.codInep &&
        incoming().escolaNome == resource.data.escolaNome &&
        incoming().anoLetivo == resource.data.anoLetivo &&
        incoming().createdAt == resource.data.createdAt &&
        incoming().createdBy == resource.data.createdBy &&
        isValidCdgTaskShape(taskId);
      allow delete: if canWriteEscola(resource.data.escolaNome) && isValidId(taskId);
    }

    // --- Reestruturação SIFEC: parecer_bimestral_notas ---
    // Único dado que o Parecer Bimestral efetivamente grava: os
    // encaminhamentos da superintendência para a escola, por bimestre. Os
    // outros 8 cards do parecer só leem dados já existentes de outras
    // coleções.
    function isValidParecerBimestralNoteShape(noteId) {
      let data = incoming();
      return data.keys().hasOnly([
          'id', 'schoolId', 'codInep', 'escolaNome', 'anoLetivo', 'bimestre',
          'encaminhamentos', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ]) &&
        data.id == noteId &&
        data.schoolId is string && data.schoolId.size() <= 128 &&
        data.codInep is string && data.codInep.size() <= 50 &&
        data.escolaNome is string && data.escolaNome.size() <= 150 &&
        isValidAnoLetivo(data.anoLetivo) &&
        data.bimestre in [1, 2, 3, 4] &&
        noteId == data.schoolId + '_' + string(data.anoLetivo) + '_b' + string(data.bimestre) &&
        data.encaminhamentos is string && data.encaminhamentos.size() <= 4000 &&
        data.createdAt is string && data.updatedAt is string &&
        data.createdBy is string && data.updatedBy is string;
    }

    match /parecer_bimestral_notas/{noteId} {
      allow read: if canWriteSchoolById(resource.data.get('schoolId', ''));
      allow create: if isValidId(noteId) &&
        canWriteEscola(incoming().escolaNome) &&
        isCanonicalSchoolMatch(incoming().schoolId, incoming().codInep, incoming().escolaNome) &&
        isValidParecerBimestralNoteShape(noteId);
      allow update: if isValidId(noteId) &&
        canWriteEscola(resource.data.escolaNome) &&
        incoming().schoolId == resource.data.schoolId &&
        incoming().codInep == resource.data.codInep &&
        incoming().escolaNome == resource.data.escolaNome &&
        incoming().anoLetivo == resource.data.anoLetivo &&
        incoming().bimestre == resource.data.bimestre &&
        incoming().createdAt == resource.data.createdAt &&
        incoming().createdBy == resource.data.createdBy &&
        isValidParecerBimestralNoteShape(noteId);
      allow delete: if isPlatformAdmin() && isValidId(noteId);
    }

    // --- Auditoria da reestruturação SIFEC: grade_entry_monitoring_disciplina ---
    // Requisito central do Acompanhamento de Notas: dimensão turma+
    // disciplina, coleção NOVA e separada de grade_entry_monitoring (que
    // continua intocada — total por turma, sem disciplina, ainda usado pelo
    // fluxo de registro do SIGE). Mesma integridade canônica de
    // grade_entry_monitoring (isCanonicalTurmaOfSchoolYearAndName).
    // Correção final da auditoria, seção 3: disciplina deixou de ser uma
    // lista fechada de 4 áreas — disciplinaId (chave normalizada e segura)
    // + disciplinaNome (texto livre, exibição) + areaConhecimento
    // (opcional). As regras NÃO replicam a normalização Unicode completa do
    // cliente (normalizeDisciplinaId — NFD + remoção de diacríticos; sem
    // suporte equivalente na linguagem de regras do Firestore), então só
    // validam o FORMATO de disciplinaId (minúsculas/dígitos/hífen, sem
    // hífen nas pontas) — mesmo tradeoff já aceito para IDs de escola
    // gerados no cliente em EscolasView.tsx. A integridade real do ID do
    // documento continua garantida: entryId precisa bater exatamente com a
    // chave composta usando disciplinaId.
    function isValidGradeEntryMonitoringDisciplineShape(entryId) {
      let data = incoming();
      return data.keys().hasOnly([
          'id', 'schoolId', 'codInep', 'escolaNome', 'turmaId', 'turmaNome',
          'anoLetivo', 'bimestre', 'disciplinaId', 'disciplinaNome', 'areaConhecimento',
          'expectedGradeEntries', 'completedGradeEntries', 'status', 'referenceDate',
          'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ]) &&
        data.id == entryId &&
        data.schoolId is string && data.schoolId.size() <= 128 &&
        data.codInep is string && data.codInep.size() <= 50 &&
        data.escolaNome is string && data.escolaNome.size() <= 150 &&
        data.turmaId is string && data.turmaId.size() <= 128 &&
        data.turmaNome is string && data.turmaNome.size() <= 150 &&
        isValidAnoLetivo(data.anoLetivo) &&
        data.bimestre in [1, 2, 3, 4] &&
        data.disciplinaId is string && data.disciplinaId.size() > 0 && data.disciplinaId.size() <= 100 &&
        data.disciplinaId.matches('^[a-z0-9]+(-[a-z0-9]+)*$') &&
        data.disciplinaNome is string && data.disciplinaNome.size() > 0 && data.disciplinaNome.size() <= 100 &&
        (!('areaConhecimento' in data) ||
          data.areaConhecimento in ['Linguagens', 'Matemática', 'Ciências da Natureza', 'Ciências Humanas', 'Formação Técnica', 'Outra']) &&
        entryId == data.schoolId + '_' + string(data.anoLetivo) + '_b' + string(data.bimestre) + '_' + data.turmaId + '_' + data.disciplinaId &&
        isNonNegInt(data.expectedGradeEntries) &&
        isNonNegInt(data.completedGradeEntries) &&
        data.completedGradeEntries <= data.expectedGradeEntries &&
        data.status in ['rascunho', 'confirmado'] &&
        data.referenceDate is string &&
        data.referenceDate.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$') &&
        data.createdAt is string && data.updatedAt is string &&
        data.createdBy is string && data.updatedBy is string;
    }

    match /grade_entry_monitoring_disciplina/{entryId} {
      allow read: if canWriteSchoolById(resource.data.get('schoolId', ''));
      allow create: if isValidId(entryId) &&
        canWriteEscola(incoming().escolaNome) &&
        isCanonicalSchoolMatch(incoming().schoolId, incoming().codInep, incoming().escolaNome) &&
        isCanonicalTurmaOfSchoolYearAndName(incoming().turmaId, incoming().schoolId, incoming().anoLetivo, incoming().turmaNome) &&
        isValidGradeEntryMonitoringDisciplineShape(entryId);
      // areaConhecimento NUNCA é travada aqui de propósito — é um campo de
      // organização/reclassificação, não de identidade (diferente de
      // disciplinaId/disciplinaNome, que travam junto com turmaId/turmaNome
      // abaixo, mesmo princípio de identidade imutável pós-criação já usado
      // nas demais coleções desta reestruturação).
      allow update: if isValidId(entryId) &&
        canWriteEscola(resource.data.escolaNome) &&
        incoming().schoolId == resource.data.schoolId &&
        incoming().codInep == resource.data.codInep &&
        incoming().escolaNome == resource.data.escolaNome &&
        incoming().turmaId == resource.data.turmaId &&
        incoming().turmaNome == resource.data.turmaNome &&
        incoming().anoLetivo == resource.data.anoLetivo &&
        incoming().bimestre == resource.data.bimestre &&
        incoming().disciplinaId == resource.data.disciplinaId &&
        incoming().disciplinaNome == resource.data.disciplinaNome &&
        incoming().createdAt == resource.data.createdAt &&
        incoming().createdBy == resource.data.createdBy &&
        isValidGradeEntryMonitoringDisciplineShape(entryId);
      allow delete: if isPlatformAdmin() && isValidId(entryId);
    }

    // --- Fase 2A: imports ---
    // Sem escolaNome no schema (seção 15) — autorização por escola faz
    // lookup em `schools/{schoolId}` via canWriteSchoolById(). Todo import
    // nasce em 'analisando' ou 'aguardando_confirmacao': nunca é possível
    // CRIAR um documento já 'confirmado'/'processado' por esta via.
    match /imports/{importId} {
      // Mesma restrição por escola de canAccessEscola(), via lookup por
      // schoolId (ver canWriteSchoolById — imports não tem escolaNome).
      // .get() com default pelo mesmo motivo do comentário em school_years.
      allow read: if canWriteSchoolById(resource.data.get('schoolId', ''));
      // isAuthorized() sai daqui de propósito (revisão pós-PR #8, mesmo
      // motivo de school_years/enrollment_snapshots): canWriteSchoolById()
      // já implica isAuthorized() quando bem-sucedido, e cada chamada extra
      // a isAdmin()/isActiveSuperintendent() pesa no limite de 1000
      // sub-expressões do emulador local — orçamento que ficou mais
      // apertado depois de somar isCanonicalCodInepForSchool() aqui.
      allow create: if isValidId(importId) &&
        incoming().schoolId is string &&
        // Checagem de integridade, independente de autorização: mesmo um
        // admin não pode criar um import apontando para um schoolId que não
        // existe em `schools` (seção 23 do plano — "importação sem escola
        // válida rejeitada").
        exists(/databases/$(database)/documents/schools/$(incoming().schoolId)) &&
        canWriteSchoolById(incoming().schoolId) &&
        // codInep canônico (revisão pós-PR #8, seção 8): mesmo schoolId
        // correto, um import não pode declarar o codInep de OUTRA escola.
        isCanonicalCodInepForSchool(incoming().schoolId, incoming().codInep) &&
        incoming().status in ['analisando', 'aguardando_confirmacao'] &&
        incoming().keys().hasOnly([
          'id', 'sourceSystem', 'reportType', 'reportTitle', 'fileName', 'fileHash',
          'schoolId', 'codInep', 'anoLetivo', 'mesReferencia', 'bimestre',
          'recordsRead', 'recordsCreated', 'recordsUpdated', 'recordsIgnored',
          'inconsistencies', 'status', 'preview',
          'createdAt', 'confirmedAt', 'processedAt', 'createdBy', 'confirmedBy'
        ]) &&
        incoming().id is string &&
        incoming().sourceSystem in ['Manual', 'SIGE Escola', 'SIGAE', 'Importação administrativa', 'Migração'] &&
        incoming().reportType is string && incoming().reportType.size() <= 150 &&
        incoming().reportTitle is string && incoming().reportTitle.size() <= 200 &&
        incoming().fileName is string && incoming().fileName.size() <= 260 &&
        incoming().fileHash is string && incoming().fileHash.size() <= 128 &&
        incoming().schoolId is string && incoming().schoolId.size() <= 128 &&
        incoming().codInep is string && incoming().codInep.size() <= 50 &&
        // ID determinístico validado contra os campos internos (mesmo
        // padrão de school_years/enrollment_snapshots — ver
        // buildImportId em src/lib/importService.ts: schoolId_fileHash).
        importId == incoming().schoolId + '_' + incoming().fileHash &&
        incoming().id == importId &&
        isValidAnoLetivo(incoming().anoLetivo) &&
        isNonNegInt(incoming().recordsRead) &&
        isNonNegInt(incoming().recordsCreated) &&
        isNonNegInt(incoming().recordsUpdated) &&
        isNonNegInt(incoming().recordsIgnored) &&
        incoming().inconsistencies is list &&
        incoming().createdAt is string &&
        incoming().createdBy is string;
      // Update cobre tanto reprocessar o preview quanto confirmar/avançar o
      // status — em ambos os casos exige poder escrever na MESMA escola do
      // import (admin, ou o superintendente vinculado a ela). Um
      // superintendente sem vínculo àquela escola nunca confirma o import
      // (seção 19 do plano).
      // A escola do import nunca muda por update (só um novo import aponta
      // para outra escola) — comparar por igualdade em vez de chamar
      // canWriteSchoolById() duas vezes evita duplicar toda a cadeia de
      // get()/exists() interna e estourar o limite de expressões do
      // emulador local em avaliações mais profundas.
      // id/codInep/anoLetivo/fileHash/createdAt/createdBy travados como
      // imutáveis (revisão pós-PR #8) — update é só para reprocessar o
      // preview/avançar o status, nunca para reescrever de qual arquivo ou
      // ano letivo o import veio, nem sua autoria original.
      allow update: if isAuthorized() && isValidId(importId) &&
        incoming().schoolId == resource.data.get('schoolId', '') &&
        canWriteSchoolById(incoming().schoolId) &&
        incoming().keys().hasOnly([
          'id', 'sourceSystem', 'reportType', 'reportTitle', 'fileName', 'fileHash',
          'schoolId', 'codInep', 'anoLetivo', 'mesReferencia', 'bimestre',
          'recordsRead', 'recordsCreated', 'recordsUpdated', 'recordsIgnored',
          'inconsistencies', 'status', 'preview',
          'createdAt', 'confirmedAt', 'processedAt', 'createdBy', 'confirmedBy'
        ]) &&
        incoming().id == resource.data.id &&
        incoming().codInep == resource.data.codInep &&
        incoming().anoLetivo == resource.data.anoLetivo &&
        incoming().fileHash == resource.data.fileHash &&
        incoming().createdAt == resource.data.createdAt &&
        incoming().createdBy == resource.data.createdBy &&
        incoming().status in [
          'analisando', 'aguardando_confirmacao', 'confirmado',
          'processado', 'processado_com_alertas', 'cancelado', 'erro'
        ] &&
        isNonNegInt(incoming().recordsRead) &&
        isNonNegInt(incoming().recordsCreated) &&
        isNonNegInt(incoming().recordsUpdated) &&
        isNonNegInt(incoming().recordsIgnored);
      allow delete: if isPlatformAdmin() && isValidId(importId);
    }

    // --- Fase 2A: audit_logs ---
    // Somente-criação por design: update/delete sempre bloqueados, inclusive
    // para admin — uma trilha de auditoria que pode ser editada não serve
    // para nada. userEmail precisa bater com quem está autenticado, para que
    // ninguém grave um log em nome de outra pessoa.
    //
    // Revisão pós-PR #8 (seção 11 do plano): logs de coleções escolares
    // (isSchoolScopedAuditCollection) agora exigem schoolId/codInep válidos
    // — escola existente, codInep canônico, e o autor precisa ter acesso de
    // escrita àquela escola (canWriteSchoolById, que já implica
    // isAuthorized()) — nunca um log escolar apontando para a carteira de
    // outro superintendente. Logs de coleções não-escolares continuam só
    // exigindo isAuthorized().
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isValidId(logId) &&
        incoming().keys().hasOnly([
          'id', 'collectionName', 'documentId', 'schoolId', 'codInep', 'anoLetivo',
          'operation', 'previousValue', 'newValue', 'source', 'importBatchId',
          'userId', 'userEmail', 'timestamp'
        ]) &&
        incoming().id is string &&
        incoming().collectionName is string && incoming().collectionName.size() <= 100 &&
        incoming().documentId is string && incoming().documentId.size() <= 200 &&
        incoming().operation in ['create', 'update', 'archive', 'import', 'correction'] &&
        incoming().source in ['Manual', 'SIGE Escola', 'SIGAE', 'Importação administrativa', 'Migração'] &&
        incoming().userId is string &&
        incoming().userEmail is string && incoming().userEmail.lower() == myEmail() &&
        incoming().timestamp is string &&
        (
          isSchoolScopedAuditCollection(incoming().collectionName)
            ? (
                incoming().schoolId is string &&
                canWriteSchoolById(incoming().schoolId) &&
                incoming().codInep is string &&
                isCanonicalCodInepForSchool(incoming().schoolId, incoming().codInep)
              )
            : isAuthorized()
        );
      allow update, delete: if false;
    }
  }
}
