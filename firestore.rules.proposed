rules_version = '2';

// ============================================================================
// PROPOSTA DE REGRAS — NÃO PUBLICADA (firebase.json ainda aponta para
// firestore.rules, o arquivo original). Este arquivo é só para revisão.
//
// Problema que estas regras corrigem: em firestore.rules (versão em
// produção), a leitura de schools/turmas/grades/visitas exige apenas
// isSignedIn() — qualquer conta Google autenticada, mesmo nunca cadastrada
// como superintendente, consegue ler nomes e notas de alunos. As regras de
// ESCRITA já eram corretamente restritas a superintendentes cadastrados
// (via myEscolas()/canWriteEscola()) — só a leitura estava aberta demais.
//
// Mudança de schema proposta:
//   - superintendentes/{email} ganha um campo OBRIGATÓRIO `ativo: boolean` e
//     um campo opcional `role: 'admin' | 'superintendente'` (default
//     'superintendente' quando ausente — só `ativo` é fail-closed).
//   - FAIL-CLOSED: um documento SEM `ativo`, ou com `ativo: false`, é tratado
//     como NÃO autorizado. Isso é uma mudança de comportamento em relação à
//     primeira versão desta proposta (que tratava `ativo` ausente como
//     `true`) — o admin raiz (isPlatformAdmin(), checado só por e-mail, sem
//     depender do documento) continua com acesso mesmo assim, mas qualquer
//     OUTRO superintendente cadastrado hoje (sem o campo `ativo`) FICARÁ
//     BLOQUEADO até rodar o script de migração (scripts/migrate-ativo-field.mjs)
//     que preenche `ativo: true` nos registros existentes. Publicar estas
//     regras sem rodar a migração antes derruba o acesso de todo mundo que
//     não seja o admin raiz — ver relatório, item "riscos restantes".
//   Nenhuma tela foi alterada para gerenciar esses campos nesta fase — é
//   trabalho de UI futuro (fora do escopo desta Fase 0).
//
// LIMITAÇÃO CONHECIDA (ver auditoria, item "riscos restantes"):
//   A coleção `grades` não tem campo escolaNome/escolaId no schema atual
//   (o campo `turma` é um nome de exibição como "3º Ano A - Matutino", que
//   SE REPETE entre escolas diferentes nos dados de exemplo — não é uma
//   chave confiável para localizar a escola dona da nota via lookup em
//   `turmas`). Por isso não é possível aplicar aqui o princípio de menor
//   privilégio por escola em `grades` sem alterar o formato de dados
//   (fora do escopo pedido) ou mexer em NotasView.tsx (também fora do
//   escopo pedido). Como mitigação parcial, `grades` fica restrito a
//   superintendentes cadastrados e ativos (fecha o buraco de "qualquer
//   conta Google"), mas não é isolado por escola. Ver recomendação no
//   relatório para uma fase futura.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Barreira global: nega tudo que não casar com uma regra específica abaixo.
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return isSignedIn() && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : null;
    }

    // Admin "raiz"/break-glass: identidade explícita, não é checagem de
    // domínio de e-mail (@seduc.ce.gov.br não é usado como autorização).
    function isPlatformAdmin() {
      return isSignedIn() && myEmail() == 'fernandomariodasmartins@gmail.com';
    }

    function superintendentDoc() {
      return get(/databases/$(database)/documents/superintendentes/$(myEmail()));
    }

    function isRegisteredSuperintendent() {
      return isSignedIn() && myEmail() != null &&
        exists(/databases/$(database)/documents/superintendentes/$(myEmail()));
    }

    // FAIL-CLOSED: `ativo` ausente ou false == não autorizado. Só um
    // documento com `ativo == true` explícito passa. Isso exige rodar a
    // migração (scripts/migrate-ativo-field.mjs) antes de publicar estas
    // regras, senão superintendentes existentes ficam bloqueados.
    function isActiveSuperintendent() {
      return isRegisteredSuperintendent() &&
        superintendentDoc().data.get('ativo', false) == true;
    }

    // Admin = admin raiz OU um superintendente ativo cujo próprio documento
    // tem role == 'admin'. Como só admins podem escrever na coleção
    // `superintendentes` (ver match abaixo), ninguém consegue setar esse
    // campo em si mesmo — a única forma de virar admin é um admin existente
    // conceder isso explicitamente.
    function isAdmin() {
      return isPlatformAdmin() ||
        (isActiveSuperintendent() && superintendentDoc().data.get('role', '') == 'admin');
    }

    // "Autorizado" = qualquer superintendente cadastrado e ativo, ou admin.
    function isAuthorized() {
      return isActiveSuperintendent() || isAdmin();
    }

    function myEscolas() {
      return isActiveSuperintendent() ? superintendentDoc().data.get('escolas', []) : [];
    }

    function canWriteEscola(escolaNome) {
      return isAdmin() || (isActiveSuperintendent() && escolaNome in myEscolas());
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Documentos de `superintendentes` são identificados por e-mail (contém
    // "@" e "."), então precisam de um formato de ID diferente de isValidId().
    function isValidEmailId(id) {
      return id is string && id.size() <= 150 &&
        id.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // --- Superintendentes ---
    // Get: o próprio usuário lê seu registro, ou admin lê qualquer um.
    // List: só admin (evita enumerar todos os e-mails cadastrados).
    // Create/update: só admin — é isso que impede autopromoção a admin/ativo.
    // Delete: só o admin raiz (dado de staffing é histórico — deixar de ser
    // superintendente deveria ser "ativo: false", não exclusão; exclusão
    // física fica restrita ao admin raiz para casos de limpeza real).
    match /superintendentes/{emailKey} {
      allow get: if isSignedIn() && (isAdmin() || myEmail() == emailKey);
      allow list: if isAdmin();
      // `ativo` é obrigatório (não tem default) — força quem cria/edita a
      // decidir explicitamente o estado, em vez de confiar num default.
      allow create, update: if isAdmin() && isValidEmailId(emailKey) &&
        incoming().nome is string && incoming().nome.size() <= 150 &&
        incoming().cargo is string && incoming().cargo.size() <= 150 &&
        incoming().email is string && incoming().email.lower() == emailKey &&
        incoming().escolas is list &&
        incoming().ativo is bool &&
        incoming().get('role', 'superintendente') in ['admin', 'superintendente'];
      allow delete: if isPlatformAdmin() && isValidEmailId(emailKey);
    }

    // --- Schools ---
    match /schools/{schoolId} {
      allow read: if isAuthorized();
      allow create: if isAdmin() && isValidId(schoolId) &&
        incoming().nome is string && incoming().nome.size() <= 150 &&
        incoming().codInep is string && incoming().codInep.size() <= 50 &&
        incoming().cidade is string && incoming().cidade.size() <= 100 &&
        incoming().matriculas is number &&
        incoming().idebMedio is number &&
        incoming().metaIdeb is number &&
        incoming().status is string;
      allow update: if isAuthorized() && isValidId(schoolId) &&
        canWriteEscola(resource.data.nome) &&
        incoming().nome is string && incoming().nome.size() <= 150 &&
        incoming().codInep is string && incoming().codInep.size() <= 50 &&
        incoming().cidade is string && incoming().cidade.size() <= 100 &&
        incoming().matriculas is number &&
        incoming().idebMedio is number &&
        incoming().metaIdeb is number &&
        incoming().status is string;
      // Dado histórico/cadastral — sem exclusão livre, só admin raiz.
      allow delete: if isPlatformAdmin() && isValidId(schoolId);
    }

    // --- Turmas ---
    match /turmas/{turmaId} {
      allow read: if isAuthorized();
      allow create, update: if isAuthorized() && isValidId(turmaId) &&
        canWriteEscola(incoming().escolaNome) &&
        incoming().escolaId is string && incoming().escolaId.size() <= 128 &&
        incoming().escolaNome is string && incoming().escolaNome.size() <= 150 &&
        incoming().nome is string && incoming().nome.size() <= 100 &&
        incoming().ano is string && incoming().ano.size() <= 20 &&
        incoming().periodo is string && incoming().periodo.size() <= 50 &&
        incoming().alunosSinalizados is number;
      allow delete: if isAuthorized() && isValidId(turmaId) &&
        canWriteEscola(resource.data.escolaNome);
    }

    // --- Grades (Opção C — mitigação temporária, ver Fase 0) ---
    // grades ainda não tem schoolId; isolamento por escola fica para uma
    // migração posterior (docs/plano-migracao-grades-schoolId.md). Até lá,
    // isAuthorized() (superintendente ativo ou admin) é a mitigação — evita
    // leitura/escrita por conta não cadastrada, mas não isola por escola.
    match /grades/{gradeId} {
      allow read: if isAuthorized();
      allow create, update: if isAuthorized() && isValidId(gradeId) &&
        incoming().nome is string && incoming().nome.size() <= 150 &&
        incoming().turma is string && incoming().turma.size() <= 100 &&
        incoming().portugues is number &&
        incoming().matematica is number &&
        incoming().ciencias is number &&
        incoming().bimestre is string;
      allow delete: if isAdmin() && isValidId(gradeId);
    }

    // --- Visitas ---
    match /visitas/{visitaId} {
      allow read: if isAuthorized();
      allow create, update: if isAuthorized() && isValidId(visitaId) &&
        canWriteEscola(incoming().escola) &&
        incoming().escola is string && incoming().escola.size() <= 150 &&
        incoming().tecnico is string && incoming().tecnico.size() <= 150 &&
        incoming().data is string && incoming().data.size() <= 30 &&
        incoming().foco is string && incoming().foco.size() <= 200 &&
        incoming().status is string;
      allow delete: if isAuthorized() && isValidId(visitaId) &&
        canWriteEscola(resource.data.escola);
    }
  }
}
